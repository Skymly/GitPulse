<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:android="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.AndroidSpecific;assembly=Microsoft.Maui.Controls"
             xmlns:local="clr-namespace:GitPulse.App"
             xmlns:conv="clr-namespace:GitPulse.App.Converters"
             x:Class="GitPulse.App.App"
             android:Application.WindowSoftInputModeAdjust="Resize">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Global converters -->
            <conv:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <conv:StringToBoolConverter x:Key="StringToBoolConverter" />
            <conv:StringEqualsConverter x:Key="StringEqualsConverter" />
            <conv:NotNullConverter x:Key="NotNullConverter" />
            <conv:IntGreaterThanZeroConverter x:Key="IntGreaterThanZeroConverter" />
            <conv:StringTruncateConverter x:Key="StringTruncateConverter" />
            <conv:JoinStringsConverter x:Key="JoinStringsConverter" />
            <conv:CollectionToBoolConverter x:Key="CollectionToBoolConverter" />
            <conv:PullRequestStateTextConverter x:Key="PullRequestStateTextConverter" />
            <conv:PullRequestStateColorConverter x:Key="PullRequestStateColorConverter" />
            <conv:PullRequestIconConverter x:Key="PullRequestIconConverter" />
            <conv:IssueStateTextConverter x:Key="IssueStateTextConverter" />
            <conv:IssueStateColorConverter x:Key="IssueStateColorConverter" />
            <conv:IssueIconConverter x:Key="IssueIconConverter" />
            <conv:NotificationIconConverter x:Key="NotificationIconConverter" />
            <conv:NotificationNumberConverter x:Key="NotificationNumberConverter" />
            <conv:NotificationReasonConverter x:Key="NotificationReasonConverter" />
            <conv:UnreadEdgeConverter x:Key="UnreadEdgeConverter" />
            <conv:HexColorConverter x:Key="HexColorConverter" />
            <conv:CheckConclusionColorConverter x:Key="CheckConclusionColorConverter" />
            <conv:CheckRunStateTextConverter x:Key="CheckRunStateTextConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
