<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- GitPulse visual language (docs/design/Ux.md). Accent is Fluent blue,
         never OS accent, never Domain Color. -->
    <Color x:Key="Accent">#0078D4</Color>
    <Color x:Key="AccentDark">#60CDFF</Color>
    <Color x:Key="AccentHover">#106EBE</Color>

    <!-- Domain Color — GitHub object states (Primer roles, GitPulse tokens). -->
    <Color x:Key="DomainOpen">#107C10</Color>
    <Color x:Key="DomainOpenDark">#6CCB5F</Color>
    <Color x:Key="DomainDone">#5C2D91</Color>
    <Color x:Key="DomainDoneDark">#B9A0D0</Color>
    <Color x:Key="DomainDanger">#C42B1C</Color>
    <Color x:Key="DomainDangerDark">#FF99A4</Color>
    <Color x:Key="DomainDraft">#6E6E6E</Color>
    <Color x:Key="DomainDraftDark">#9A9A9A</Color>
    <Color x:Key="DomainAttention">#9D5D00</Color>
    <Color x:Key="DomainAttentionDark">#FCE100</Color>
    <Color x:Key="DomainSkip">#5D5D5D</Color>
    <Color x:Key="DomainSkipDark">#C8C8C8</Color>

    <!-- Chrome Neutral — platform surfaces. Dark is dark gray, not pure black. -->
    <Color x:Key="ChromePage">#FFFFFF</Color>
    <Color x:Key="ChromePageDark">#2C2C2C</Color>
    <Color x:Key="ChromeBase">#F3F3F3</Color>
    <Color x:Key="ChromeBaseDark">#202020</Color>
    <Color x:Key="ChromeLine">#E5E5E5</Color>
    <Color x:Key="ChromeLineDark">#3F3F3F</Color>
    <Color x:Key="ChromeText">#1A1A1A</Color>
    <Color x:Key="ChromeTextDark">#FFFFFF</Color>
    <Color x:Key="ChromeMuted">#5D5D5D</Color>
    <Color x:Key="ChromeMutedDark">#C8C8C8</Color>
    <Color x:Key="ChromeFill">#E8E8E8</Color>
    <Color x:Key="ChromeFillDark">#3A3A3A</Color>

    <!-- Aliases so existing XAML picks up the language. Primary = Accent. -->
    <Color x:Key="Primary">#0078D4</Color>
    <Color x:Key="PrimaryDark">#60CDFF</Color>
    <Color x:Key="PrimaryDarkText">#1A1A1A</Color>
    <Color x:Key="Secondary">#E8E8E8</Color>
    <Color x:Key="SecondaryDarkText">#C8C8C8</Color>
    <Color x:Key="Tertiary">#0078D4</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">#1A1A1A</Color>
    <Color x:Key="Magenta">#0078D4</Color>
    <Color x:Key="MidnightBlue">#202020</Color>
    <Color x:Key="OffBlack">#2C2C2C</Color>

    <Color x:Key="Gray100">#F3F3F3</Color>
    <Color x:Key="Gray200">#E5E5E5</Color>
    <Color x:Key="Gray300">#C8C8C8</Color>
    <Color x:Key="Gray400">#9A9A9A</Color>
    <Color x:Key="Gray500">#5D5D5D</Color>
    <Color x:Key="Gray600">#5D5D5D</Color>
    <Color x:Key="Gray900">#1A1A1A</Color>
    <Color x:Key="Gray950">#202020</Color>

    <!-- Legacy semantic names remapped to Domain Color roles. -->
    <Color x:Key="Green100">#E4F7E4</Color>
    <Color x:Key="Green700">#107C10</Color>
    <Color x:Key="Green900">#0B5A0B</Color>
    <Color x:Key="Purple700">#5C2D91</Color>
    <Color x:Key="Orange900">#6E6E6E</Color>
    <Color x:Key="Red100">#FDE7E9</Color>
    <Color x:Key="Red900">#C42B1C</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>
    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
