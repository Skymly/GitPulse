<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>GitPulse.App</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>

		<!-- Enable XAML source generation for faster build times and improved performance. -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Display name -->
		<ApplicationTitle>GitPulse</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.skymly.gitpulse</ApplicationId>

		<!-- 0.1.0 is the design-time / format fallback (MinVer skips when
		     DesignTimeBuild=true, which would otherwise yield ".."). Real
		     builds overwrite this after MinVer. ApplicationVersion is the
		     integer Android versionCode / Windows package revision. -->
		<ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

		<!-- Microsoft.Maui.Controls stays on $(MauiVersion) via VersionOverride so
		     CPM does not pin a second MAUI/WindowsAppSDK matrix. App-only packages
		     also use VersionOverride. Shared packages (R3, Observables, Mvvm,
		     logging) take versions from Directory.Packages.props. -->
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0078D4" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0078D4" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Indiko.Maui.Controls.Markdown" VersionOverride="1.5.0" />
		<PackageReference Include="Microsoft.Maui.Controls" VersionOverride="$(MauiVersion)" />
		<PackageReference Include="R3" />
		<PackageReference Include="R3Extensions.Maui" />
		<PackageReference Include="Observables.RestAPI.R3" />
		<PackageReference Include="Observables.Events.R3" />
		<PackageReference Include="CommunityToolkit.Mvvm" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" />
		<PackageReference Include="System.Security.Cryptography.ProtectedData" VersionOverride="10.0.12" Condition="$(TargetFramework.Contains('windows'))" />
		<PackageReference Include="H.NotifyIcon.WinUI" VersionOverride="2.4.1" Condition="$(TargetFramework.Contains('windows'))" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\GitPulse.Core\GitPulse.Core.csproj" />
		<ProjectReference Include="..\GitPulse.GitHubApi\GitPulse.GitHubApi.csproj" />
		<ProjectReference Include="..\GitPulse.Services\GitPulse.Services.csproj" />
		<ProjectReference Include="..\GitPulse.ViewModels\GitPulse.ViewModels.csproj" />
	</ItemGroup>

	<!-- MinVer runs before compile. MAUI writes ApplicationDisplayVersion into
	     the Windows Appx manifest and Android versionName earlier than that,
	     so pull MinVer in as a dependency of those targets. Use major.minor.patch
	     only: Windows Identity Version cannot carry a SemVer prerelease label. -->
	<PropertyGroup>
		<MauiGeneratePackageAppxManifestDependsOnTargets>
			MinVer;
			SetApplicationDisplayVersionFromMinVer;
			$(MauiGeneratePackageAppxManifestDependsOnTargets)
		</MauiGeneratePackageAppxManifestDependsOnTargets>
	</PropertyGroup>
	<Target Name="SetApplicationDisplayVersionFromMinVer"
	        DependsOnTargets="MinVer"
	        BeforeTargets="MauiGeneratePackageAppxManifest;_GetAndroidPackageName">
		<!-- Target Condition is evaluated before DependsOnTargets. MinVer skips
		     DesignTimeBuild (dotnet format), so keep the 0.1.0 fallback then. -->
		<PropertyGroup Condition="'$(MinVerMajor)' != ''">
			<ApplicationDisplayVersion>$(MinVerMajor).$(MinVerMinor).$(MinVerPatch)</ApplicationDisplayVersion>
		</PropertyGroup>
	</Target>

</Project>
