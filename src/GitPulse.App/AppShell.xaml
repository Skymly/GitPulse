<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="GitPulse.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:GitPulse.App.Views"
    Title="GitPulse">

    <TabBar Route="MainTabBar">
        <ShellContent
            x:Name="TabRepos"
            Title="Repos"
            Icon="tab_repos.png"
            ContentTemplate="{DataTemplate views:ReposPage}"
            Route="ReposPage"
            AutomationId="TabRepos" />

        <ShellContent
            x:Name="TabNotifications"
            Title="Notifications"
            Icon="tab_notifications.png"
            ContentTemplate="{DataTemplate views:NotificationsPage}"
            Route="NotificationsPage"
            AutomationId="TabNotifications" />

        <ShellContent
            x:Name="TabSearch"
            Title="Search"
            Icon="tab_search.png"
            ContentTemplate="{DataTemplate views:SearchPage}"
            Route="SearchPage"
            AutomationId="TabSearch" />

        <ShellContent
            x:Name="TabSettings"
            Title="Settings"
            Icon="tab_settings.png"
            ContentTemplate="{DataTemplate views:SettingsPage}"
            Route="SettingsPage"
            AutomationId="TabSettings" />
    </TabBar>

</Shell>
