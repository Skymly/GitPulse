<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GitPulse.ViewModels;assembly=GitPulse.ViewModels"
             xmlns:models="clr-namespace:GitPulse.Core.Models;assembly=GitPulse.Core"
             x:Class="GitPulse.App.Views.ReposPage"
             x:DataType="vm:ReposViewModel"
             Title="Repositories"
             AutomationId="ReposPageRoot">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <VerticalStackLayout Grid.Row="0" Spacing="0">
            <SearchBar x:Name="SearchBar"
                       Placeholder="Filter repositories..."
                       Text="{Binding SearchText.Value}"
                       Margin="16,12,16,4"
                       AutomationId="ReposSearchBar" />

            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="8"
                  Margin="16,0,16,8">
                <Button x:Name="MyReposHubButton"
                        Text="My repos"
                        Command="{Binding SelectHubCommand}"
                        CommandParameter="{x:Static vm:ReposViewModel.MyReposHub}"
                        Padding="12,10"
                        FontSize="13"
                        HorizontalOptions="Fill"
                        AutomationId="ReposMyReposHub" />
                <Button x:Name="StarredHubButton"
                        Grid.Column="1"
                        Text="Starred"
                        Command="{Binding SelectHubCommand}"
                        CommandParameter="{x:Static vm:ReposViewModel.StarredHub}"
                        Padding="12,10"
                        FontSize="13"
                        HorizontalOptions="Fill"
                        AutomationId="ReposStarredHub" />
            </Grid>
        </VerticalStackLayout>

        <Border Grid.Row="1"
                IsVisible="{Binding ErrorMessage.Value, Converter={StaticResource StringToBoolConverter}}"
                BackgroundColor="{StaticResource Red100}"
                Stroke="Transparent"
                StrokeShape="RoundRectangle 8"
                Padding="12"
                Margin="16,0,16,8">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <Label Text="{Binding ErrorMessage.Value}"
                       TextColor="{StaticResource Red900}"
                       FontSize="13"
                       LineBreakMode="WordWrap"
                       VerticalOptions="Center" />
                <Button Grid.Column="1"
                        Text="Retry"
                        Command="{Binding LoadCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Red900}"
                        Padding="8,10"
                        FontSize="13"
                        VerticalOptions="Center" />
                <Button Grid.Column="2"
                        Text="Settings"
                        Clicked="OnOpenSettingsClicked"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Red900}"
                        Padding="8,10"
                        FontSize="13"
                        VerticalOptions="Center" />
            </Grid>
        </Border>

        <RefreshView x:Name="ListRefresh"
                     Grid.Row="2"
                     Command="{Binding LoadCommand}"
                     IsRefreshing="{Binding IsLoading.Value}">
        <CollectionView x:Name="ReposList"
                        ItemsSource="{Binding Repos}"
                        SelectionMode="Single"
                        RemainingItemsThreshold="5"
                        SelectionChanged="OnRepoSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Repo">
                    <VerticalStackLayout Spacing="0">
                    <Grid ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="10"
                          Padding="16,12"
                          MinimumHeightRequest="{OnPlatform Android=56, Default=48}"
                          AutomationId="ReposFirstItem">
                        <Image Grid.Column="0"
                               Source="repo_16.png"
                               WidthRequest="16"
                               HeightRequest="16"
                               VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding Name}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="1" />
                            <Label FontSize="12"
                                   TextColor="{StaticResource Gray500}"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="1">
                                <Label.Text>
                                    <MultiBinding StringFormat="{}{0} · {1} ★">
                                        <Binding Path="Description" />
                                        <Binding Path="StargazersCount" />
                                    </MultiBinding>
                                </Label.Text>
                            </Label>
                        </VerticalStackLayout>
                        <Label Grid.Column="2"
                               Text="private"
                               FontSize="12"
                               TextColor="{StaticResource Gray500}"
                               IsVisible="{Binding Private}"
                               VerticalOptions="Center" />
                    </Grid>
                    <BoxView Style="{StaticResource Hairline}" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        </RefreshView>

        <VerticalStackLayout Grid.Row="3" Padding="16" Spacing="8">
            <ActivityIndicator IsRunning="{Binding IsLoading.Value}"
                               IsVisible="{Binding IsLoading.Value}" />
            <Button Text="Load Repositories"
                    Command="{Binding LoadCommand}"
                    IsVisible="{Binding IsLoading.Value, Converter={StaticResource InvertedBoolConverter}}"
                    HorizontalOptions="Fill" />
            <Button Text="Load more"
                    Command="{Binding LoadMoreCommand}"
                    IsVisible="{Binding CanLoadMore.Value}"
                    HorizontalOptions="Fill"
                    Padding="24,12"
                    FontSize="13" />
        </VerticalStackLayout>

    </Grid>

</ContentPage>
