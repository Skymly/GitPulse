<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GitPulse.ViewModels;assembly=GitPulse.ViewModels"
             xmlns:models="clr-namespace:GitPulse.Core.Models;assembly=GitPulse.Core"
             x:Class="GitPulse.App.Views.WorkflowRunsPage"
             x:DataType="vm:WorkflowRunsViewModel"
             Title="Actions"
             AutomationId="WorkflowRunsPageRoot">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!-- Back + repo name: Grid so long names truncate instead of clipping Back. -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*"
              ColumnSpacing="12"
              Padding="16,12,16,4">
            <Button Grid.Column="0"
                    Text="← Repo"
                    Clicked="OnBackClicked"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Primary}"
                    Padding="8,4"
                    VerticalOptions="Center" />
            <VerticalStackLayout Grid.Column="1"
                                 Spacing="0"
                                 VerticalOptions="Center">
                <Label Text="{Binding RepoFullName.Value}"
                       FontSize="18"
                       FontAttributes="Bold"
                       LineBreakMode="TailTruncation"
                       MaxLines="1" />
                <Label Text="Actions"
                       FontSize="14"
                       TextColor="{StaticResource Gray500}"
                       LineBreakMode="TailTruncation"
                       MaxLines="1" />
            </VerticalStackLayout>
        </Grid>

        <Border Grid.Row="1"
                IsVisible="{Binding ErrorMessage.Value, Converter={StaticResource StringToBoolConverter}}"
                BackgroundColor="{StaticResource Red100}"
                StrokeShape="RoundRectangle 8"
                Padding="12"
                Margin="16,4,16,0">
            <Label Text="{Binding ErrorMessage.Value}"
                   TextColor="{StaticResource Red900}"
                   FontSize="13"
                   LineBreakMode="WordWrap" />
        </Border>

        <VerticalStackLayout Grid.Row="2"
                             Spacing="8"
                             Padding="16,8,16,0"
                             IsVisible="{Binding Workflows.Count, Converter={StaticResource IntGreaterThanZeroConverter}}">
            <Label Text="Dispatch"
                   FontSize="14"
                   FontAttributes="Bold" />
            <Picker Title="Workflow"
                    ItemsSource="{Binding Workflows}"
                    ItemDisplayBinding="{Binding Name}"
                    SelectedItem="{Binding SelectedWorkflow.Value}"
                    AutomationId="WorkflowDispatchPicker" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry Text="{Binding DispatchRef.Value}"
                       Placeholder="Branch or tag"
                       FontSize="13"
                       AutomationId="WorkflowDispatchRef" />
                <Button Grid.Column="1"
                        Text="Dispatch"
                        Command="{Binding DispatchCommand}"
                        IsEnabled="{Binding IsDispatching.Value, Converter={StaticResource InvertedBoolConverter}}"
                        Padding="16,10"
                        FontSize="13"
                        AutomationId="WorkflowDispatchButton" />
            </Grid>
        </VerticalStackLayout>

        <CollectionView Grid.Row="3"
                        ItemsSource="{Binding Runs}"
                        Margin="16,8,16,0"
                        SelectionMode="Single"
                        SelectionChanged="OnRunSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:WorkflowRun">
                    <!-- Minimum height keeps portrait tap targets usable. -->
                    <Border Margin="0,0,0,8"
                            Padding="14,16"
                            MinimumHeightRequest="56"
                            StrokeShape="RoundRectangle 8"
                            Stroke="{StaticResource Gray200}">
                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label Grid.Column="0"
                                       Text="{Binding RunNumber, StringFormat='#{0}'}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="{Binding DisplayTitle}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="2"
                                       VerticalOptions="Center" />
                            </Grid>
                            <VerticalStackLayout Spacing="2" Margin="0,2,0,0">
                                <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="12">
                                    <Label Grid.Column="0"
                                           Text="{Binding Status}"
                                           FontSize="11"
                                           TextColor="{StaticResource Gray500}"
                                           VerticalOptions="Center" />
                                    <Label Grid.Column="1"
                                           Text="{Binding Conclusion}"
                                           FontSize="11"
                                           TextColor="{StaticResource Green700}"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="1"
                                           VerticalOptions="Center" />
                                    <Label Grid.Column="2"
                                           Text="{Binding Event}"
                                           FontSize="11"
                                           TextColor="{StaticResource Gray500}"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="1"
                                           VerticalOptions="Center"
                                           HorizontalOptions="End" />
                                </Grid>
                                <Label Text="{Binding HeadBranch, StringFormat='@ {0}'}"
                                       FontSize="11"
                                       TextColor="{StaticResource Gray500}"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <ActivityIndicator Grid.Row="3"
                           IsRunning="{Binding IsLoading.Value}"
                           IsVisible="{Binding IsLoading.Value}"
                           VerticalOptions="Start"
                           Margin="0,16,0,0" />

        <!-- Invisible Load more collapses the Auto row (no empty padded footer). -->
        <Button Grid.Row="4"
                Text="Load more"
                Command="{Binding LoadMoreCommand}"
                IsVisible="{Binding CanLoadMore.Value}"
                HorizontalOptions="Fill"
                Padding="24,12"
                Margin="16"
                FontSize="13" />

    </Grid>

</ContentPage>
