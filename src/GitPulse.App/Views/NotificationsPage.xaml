<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GitPulse.ViewModels;assembly=GitPulse.ViewModels"
             xmlns:models="clr-namespace:GitPulse.Core.Models;assembly=GitPulse.Core"
             x:Class="GitPulse.App.Views.NotificationsPage"
             x:DataType="vm:NotificationsViewModel"
             Title="Notifications"
             AutomationId="NotificationsPageRoot">

    <Grid RowDefinitions="Auto,Auto,*">

        <VerticalStackLayout Grid.Row="0" Spacing="8" Padding="16,12,16,8">
            <Label Text="{Binding UnreadCount.Value, StringFormat='{0} unread'}"
                   FontSize="16"
                   FontAttributes="Bold"
                   LineBreakMode="TailTruncation"
                   MaxLines="1" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Text="Refresh"
                        Command="{Binding RefreshCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Primary}"
                        Padding="12,10"
                        FontSize="13"
                        HorizontalOptions="Fill"
                        AutomationId="NotificationsRefreshButton" />
                <Button Grid.Column="1"
                        Text="Mark all read"
                        Command="{Binding MarkAllAsReadCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Primary}"
                        Padding="12,10"
                        FontSize="13"
                        HorizontalOptions="Fill"
                        IsVisible="{Binding UnreadCount.Value, Converter={StaticResource IntGreaterThanZeroConverter}}" />
            </Grid>
        </VerticalStackLayout>

        <Border Grid.Row="1"
                IsVisible="{Binding ErrorMessage.Value, Converter={StaticResource StringToBoolConverter}}"
                BackgroundColor="{StaticResource Red100}"
                Stroke="Transparent"
                StrokeShape="RoundRectangle 8"
                Padding="12"
                Margin="16,0,16,8">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <Label Text="{Binding ErrorMessage.Value}"
                       TextColor="{StaticResource Red900}"
                       FontSize="13"
                       LineBreakMode="WordWrap"
                       VerticalOptions="Center" />
                <Button Grid.Column="1"
                        Text="Retry"
                        Command="{Binding RefreshCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Red900}"
                        Padding="8,10"
                        FontSize="13" />
                <Button Grid.Column="2"
                        Text="Settings"
                        Clicked="OnOpenSettingsClicked"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Red900}"
                        Padding="8,10"
                        FontSize="13" />
            </Grid>
        </Border>

        <RefreshView x:Name="ListRefresh"
                     Grid.Row="2"
                     Command="{Binding RefreshCommand}"
                     IsRefreshing="{Binding IsBusy.Value}">
        <CollectionView ItemsSource="{Binding Notifications}"
                        SelectionMode="Single"
                        SelectionChanged="OnNotificationSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Notification">
                    <VerticalStackLayout Spacing="0">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto"
                          ColumnSpacing="8"
                          Padding="12,10"
                          MinimumHeightRequest="{OnPlatform Android=56, Default=48}">
                        <BoxView Grid.Column="0"
                                 WidthRequest="{Binding Unread, Converter={StaticResource UnreadEdgeConverter}}"
                                 Color="{StaticResource Primary}"
                                 VerticalOptions="Fill" />
                        <Image Grid.Column="1"
                               Source="{Binding Subject.Type, Converter={StaticResource NotificationIconConverter}}"
                               WidthRequest="16"
                               HeightRequest="16"
                               VerticalOptions="Start"
                               Margin="0,4,0,0" />
                        <VerticalStackLayout Grid.Column="2" Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding Subject.Title}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="1" />
                            <Label Text="{Binding Subject.Type}"
                                   FontSize="12"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="1" />
                            <Label FontSize="12"
                                   TextColor="{StaticResource Gray500}"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="1">
                                <Label.Text>
                                    <MultiBinding StringFormat="{}{0} · {1}">
                                        <Binding Path="Repository.FullName" />
                                        <Binding Path="Reason" Converter="{StaticResource NotificationReasonConverter}" />
                                    </MultiBinding>
                                </Label.Text>
                            </Label>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="3" Spacing="4" VerticalOptions="Center">
                            <Label Text="{Binding Subject.Url, Converter={StaticResource NotificationNumberConverter}}"
                                   FontSize="12"
                                   TextColor="{StaticResource Gray500}"
                                   HorizontalOptions="End" />
                            <Button Text="Mark read"
                                    Command="{Binding BindingContext.MarkAsReadCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="Transparent"
                                    TextColor="{StaticResource Primary}"
                                    Padding="4,8"
                                    FontSize="12"
                                    IsVisible="{Binding Unread}" />
                        </VerticalStackLayout>
                    </Grid>
                    <BoxView Style="{StaticResource Hairline}" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        </RefreshView>

        <ActivityIndicator Grid.Row="2"
                           IsRunning="{Binding IsBusy.Value}"
                           IsVisible="{Binding IsBusy.Value}"
                           VerticalOptions="Start"
                           Margin="0,16,0,0" />

        <VerticalStackLayout Grid.Row="2"
                             IsVisible="{Binding Notifications.Count, Converter={StaticResource IntGreaterThanZeroConverter}, ConverterParameter=invert}"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             Spacing="8"
                             Padding="16">
            <VerticalStackLayout.Triggers>
                <DataTrigger TargetType="VerticalStackLayout"
                             Binding="{Binding IsBusy.Value}"
                             Value="True">
                    <Setter Property="IsVisible" Value="False" />
                </DataTrigger>
                <DataTrigger TargetType="VerticalStackLayout"
                             Binding="{Binding ErrorMessage.Value, Converter={StaticResource StringToBoolConverter}}"
                             Value="True">
                    <Setter Property="IsVisible" Value="False" />
                </DataTrigger>
            </VerticalStackLayout.Triggers>
            <Label Text="No notifications"
                   FontSize="16"
                   TextColor="{StaticResource Gray500}"
                   HorizontalOptions="Center"
                   LineBreakMode="WordWrap" />
            <Label Text="Nothing waiting. Refresh or wait for the next poll."
                   FontSize="14"
                   TextColor="{StaticResource Gray400}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   LineBreakMode="WordWrap" />
        </VerticalStackLayout>


    </Grid>

</ContentPage>
