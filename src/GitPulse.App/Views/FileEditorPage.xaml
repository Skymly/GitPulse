<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GitPulse.ViewModels;assembly=GitPulse.ViewModels"
             x:Class="GitPulse.App.Views.FileEditorPage"
             x:DataType="vm:FileEditorViewModel"
             Title="File Editor">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">

        <VerticalStackLayout Grid.Row="0" Spacing="4" Padding="16,8,16,4">
            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                <Button Text="Back"
                        Clicked="OnBackClicked"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Primary}"
                        Padding="8,10"
                        VerticalOptions="Center" />
                <Label Grid.Column="1"
                       Text="Files"
                       FontSize="14"
                       TextColor="{StaticResource Gray500}"
                       VerticalOptions="Center" />
                <Label Grid.Column="2"
                       Text="{Binding Title.Value}"
                       FontSize="14"
                       TextColor="{StaticResource Gray500}"
                       VerticalOptions="Center"
                       LineBreakMode="TailTruncation"
                       MaxLines="1" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <Label Text="{Binding FilePath.Value}"
                       FontSize="12"
                       TextColor="{StaticResource Gray500}"
                       LineBreakMode="MiddleTruncation"
                       MaxLines="1"
                       VerticalOptions="Center" />
                <Button x:Name="EditButton"
                        Grid.Column="1"
                        Text="Edit"
                        Command="{Binding ToggleEditCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Primary}"
                        Padding="8,10"
                        FontSize="13"
                        IsVisible="{Binding IsEditing.Value, Converter={StaticResource InvertedBoolConverter}}" />
                <Button Grid.Column="2"
                        Text="GitHub"
                        Command="{Binding OpenInBrowserCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Primary}"
                        Padding="8,10"
                        FontSize="13" />
            </Grid>
        </VerticalStackLayout>

        <Border Grid.Row="2"
                IsVisible="{Binding ErrorMessage.Value, Converter={StaticResource StringToBoolConverter}}"
                BackgroundColor="{StaticResource Red100}"
                Stroke="Transparent"
                StrokeShape="RoundRectangle 8"
                Padding="12"
                Margin="16,4,16,0">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <Label Text="{Binding ErrorMessage.Value}"
                       TextColor="{StaticResource Red900}"
                       FontSize="13"
                       VerticalOptions="Center" />
                <Button Grid.Column="1"
                        Text="Retry"
                        Clicked="OnRetryClicked"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Red900}"
                        Padding="8,10"
                        FontSize="13" />
                <Button Grid.Column="2"
                        Text="Back"
                        Clicked="OnBackClicked"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Red900}"
                        Padding="8,10"
                        FontSize="13" />
            </Grid>
        </Border>

        <Editor Grid.Row="3"
                Text="{Binding FileContent.Value}"
                IsReadOnly="{Binding IsEditing.Value, Converter={StaticResource InvertedBoolConverter}}"
                FontSize="14"
                Margin="16,8,16,0"
                AutoSize="TextChanges" />

        <ActivityIndicator Grid.Row="3"
                           IsRunning="{Binding IsBusy.Value}"
                           IsVisible="{Binding IsBusy.Value}"
                           VerticalOptions="Start"
                           Margin="0,16,0,0" />

        <VerticalStackLayout Grid.Row="4" Spacing="4" Margin="16,8,16,0">
            <Entry Text="{Binding CommitMessage.Value}"
                   Placeholder="Commit message (required to save or delete)"
                   FontSize="14"
                   MinimumHeightRequest="44" />
            <Label x:Name="CommitFieldError"
                   Text="Enter a commit message."
                   TextColor="{StaticResource Red900}"
                   FontSize="12"
                   IsVisible="False" />
        </VerticalStackLayout>

        <Grid Grid.Row="5"
              ColumnDefinitions="*,*,*"
              ColumnSpacing="8"
              Padding="16,8,16,16">
            <Button Text="Save"
                    Clicked="OnSaveClicked"
                    IsVisible="{Binding IsEditing.Value}"
                    Padding="16,12"
                    FontSize="13"
                    HorizontalOptions="Fill" />
            <Button Grid.Column="1"
                    Text="Cancel"
                    Command="{Binding ToggleEditCommand}"
                    IsVisible="{Binding IsEditing.Value}"
                    BackgroundColor="{StaticResource Gray200}"
                    TextColor="{StaticResource Gray900}"
                    Padding="16,12"
                    FontSize="13"
                    HorizontalOptions="Fill" />
            <Button x:Name="DeleteButton"
                    Grid.Column="2"
                    Text="Delete"
                    Clicked="OnDeleteClicked"
                    BackgroundColor="{StaticResource Red900}"
                    TextColor="White"
                    Padding="16,12"
                    FontSize="13"
                    HorizontalOptions="Fill" />
        </Grid>

    </Grid>

</ContentPage>
