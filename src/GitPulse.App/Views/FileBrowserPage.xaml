<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GitPulse.ViewModels;assembly=GitPulse.ViewModels"
             xmlns:models="clr-namespace:GitPulse.Core.Models;assembly=GitPulse.Core"
             x:Class="GitPulse.App.Views.FileBrowserPage"
             x:DataType="vm:FileBrowserViewModel"
             Title="Files">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Header: back + repo name + breadcrumb -->
        <VerticalStackLayout Grid.Row="0" Padding="16,12,16,4" Spacing="4">
            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                <Button Text="Back"
                        Clicked="OnBackClicked"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Primary}"
                        Padding="8,10" />
                <Label Grid.Column="1"
                       Text="Repos"
                       FontSize="14"
                       TextColor="{StaticResource Gray500}"
                       VerticalOptions="Center" />
                <Label Grid.Column="2"
                       Text="{Binding RepoFullName.Value}"
                       FontSize="14"
                       TextColor="{StaticResource Gray500}"
                       VerticalOptions="Center"
                       LineBreakMode="TailTruncation"
                       MaxLines="1" />
            </Grid>
            <!-- Breadcrumb: current path -->
            <HorizontalStackLayout Spacing="8">
                <Button Text="↑ Up"
                        Command="{Binding GoUpCommand}"
                        IsVisible="{Binding CanGoUp.Value}"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Primary}"
                        Padding="8,2"
                        FontSize="12" />
                <Label Text="{Binding CurrentPath.Value, StringFormat='/{0}'}"
                       FontSize="13"
                       TextColor="{StaticResource Gray600}"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <!-- Error banner -->
        <Border Grid.Row="1"
                IsVisible="{Binding ErrorMessage.Value, Converter={StaticResource StringToBoolConverter}}"
                BackgroundColor="{StaticResource Red100}"
                StrokeShape="RoundRectangle 8"
                Padding="12"
                Margin="16,0">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <Label Text="{Binding ErrorMessage.Value}"
                       TextColor="{StaticResource Red900}"
                       FontSize="13"
                       LineBreakMode="WordWrap"
                       VerticalOptions="Center" />
                <Button Grid.Column="1"
                        Text="Retry"
                        Command="{Binding LoadCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Red900}"
                        Padding="8,10"
                        FontSize="13" />
                <Button Grid.Column="2"
                        Text="Back"
                        Clicked="OnBackClicked"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Red900}"
                        Padding="8,10"
                        FontSize="13" />
            </Grid>
        </Border>

        <!-- File/directory list -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Entries}"
                        Margin="16,8,16,0"
                        SelectionMode="Single"
                        SelectionChanged="OnEntrySelected">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ContentEntry">
                    <VerticalStackLayout Spacing="0">
                    <Grid ColumnDefinitions="Auto,*"
                          Padding="16,12"
                          MinimumHeightRequest="{OnPlatform Android=56, Default=48}"
                          ColumnSpacing="10">
                        <Image Source="repo_16.png"
                               WidthRequest="16"
                               HeightRequest="16"
                               VerticalOptions="Center"
                               IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=dir}" />
                        <Image Source="file_16.png"
                               WidthRequest="16"
                               HeightRequest="16"
                               VerticalOptions="Center"
                               IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=file}" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding Name}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="1" />
                            <Label Text="{Binding Size, StringFormat='{0} bytes'}"
                                   FontSize="12"
                                   TextColor="{StaticResource Gray500}"
                                   IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=file}" />
                        </VerticalStackLayout>
                    </Grid>
                    <BoxView Style="{StaticResource Hairline}" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout Grid.Row="2"
                             IsVisible="{Binding Entries.Count, Converter={StaticResource IntGreaterThanZeroConverter}, ConverterParameter=invert}"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             Spacing="8"
                             Padding="16">
            <VerticalStackLayout.Triggers>
                <DataTrigger TargetType="VerticalStackLayout"
                             Binding="{Binding IsLoading.Value}"
                             Value="True">
                    <Setter Property="IsVisible" Value="False" />
                </DataTrigger>
            </VerticalStackLayout.Triggers>
            <Label Text="This folder is empty"
                   FontSize="16"
                   TextColor="{StaticResource Gray500}"
                   HorizontalOptions="Center" />
            <Label Text="There are no files here."
                   FontSize="14"
                   TextColor="{StaticResource Gray400}"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>

        <ActivityIndicator Grid.Row="2"
                           IsRunning="{Binding IsLoading.Value}"
                           IsVisible="{Binding IsLoading.Value}"
                           VerticalOptions="Start"
                           Margin="0,16,0,0" />

        <!-- New file button -->
        <Button Grid.Row="3"
                Text="+ New File"
                Clicked="OnNewFileClicked"
                BackgroundColor="{StaticResource Primary}"
                TextColor="White"
                HorizontalOptions="Center"
                Padding="24,8"
                Margin="0,8,0,16"
                FontSize="13" />

    </Grid>

</ContentPage>
