<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GitPulse.ViewModels;assembly=GitPulse.ViewModels"
             xmlns:models="clr-namespace:GitPulse.Core.Models;assembly=GitPulse.Core"
             x:Class="GitPulse.App.Views.CommitsPage"
             x:Name="_pageRoot"
             x:DataType="vm:CommitsViewModel"
             Title="Commits"
             AutomationId="CommitsPageRoot">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*"
              ColumnSpacing="12"
              Padding="16,12,16,4">
            <Button Grid.Column="0"
                    Text="← Repo"
                    Clicked="OnBackClicked"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Primary}"
                    Padding="8,4"
                    VerticalOptions="Center" />
            <VerticalStackLayout Grid.Column="1"
                                 Spacing="0"
                                 VerticalOptions="Center">
                <Label Text="{Binding RepoFullName.Value}"
                       FontSize="18"
                       FontAttributes="Bold"
                       LineBreakMode="TailTruncation"
                       MaxLines="1" />
                <Label Text="Commits"
                       FontSize="14"
                       TextColor="{StaticResource Gray500}"
                       LineBreakMode="TailTruncation"
                       MaxLines="1" />
            </VerticalStackLayout>
        </Grid>

        <Border Grid.Row="1"
                IsVisible="{Binding ErrorMessage.Value, Converter={StaticResource StringToBoolConverter}}"
                BackgroundColor="{StaticResource Red100}"
                StrokeShape="RoundRectangle 8"
                Padding="12"
                Margin="16,4,16,0">
            <Label Text="{Binding ErrorMessage.Value}"
                   TextColor="{StaticResource Red900}"
                   FontSize="13"
                   LineBreakMode="WordWrap" />
        </Border>

        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Commits}"
                        Margin="16,8,16,0">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:GitCommit">
                    <Border Margin="0,0,0,8"
                            Padding="14,16"
                            MinimumHeightRequest="56"
                            StrokeShape="RoundRectangle 8"
                            Stroke="{StaticResource Gray200}">
                        <VerticalStackLayout Spacing="4">
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCommitTapped"
                                                      CommandParameter="{Binding .}" />
                            </VerticalStackLayout.GestureRecognizers>
                            <Label Text="{Binding Commit.Message}"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="1" />
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <Label Grid.Column="0"
                                       Text="{Binding Sha}"
                                       FontSize="11"
                                       FontFamily="Consolas"
                                       TextColor="{StaticResource Primary}"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1"
                                       WidthRequest="72" />
                                <Label Grid.Column="1"
                                       Text="{Binding Commit.Author.Name}"
                                       FontSize="12"
                                       TextColor="{StaticResource Gray500}"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1" />
                                <Button Grid.Column="2"
                                        Text="Open"
                                        FontSize="12"
                                        Padding="10,6"
                                        BackgroundColor="Transparent"
                                        TextColor="{StaticResource Primary}"
                                        Command="{Binding Source={x:Reference _pageRoot}, Path=BindingContext.OpenInBrowserCommand}"
                                        CommandParameter="{Binding HtmlUrl}"
                                        IsVisible="{Binding HtmlUrl, Converter={StaticResource StringToBoolConverter}}" />
                            </Grid>
                            <Label Text="{Binding Commit.Author.Date, StringFormat='{0:yyyy-MM-dd HH:mm}'}"
                                   FontSize="11"
                                   TextColor="{StaticResource Gray500}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <ActivityIndicator Grid.Row="2"
                           IsRunning="{Binding IsLoading.Value}"
                           IsVisible="{Binding IsLoading.Value}"
                           VerticalOptions="Start"
                           Margin="0,16,0,0" />

        <Button Grid.Row="3"
                Text="Load more"
                Command="{Binding LoadMoreCommand}"
                IsVisible="{Binding CanLoadMore.Value}"
                HorizontalOptions="Fill"
                Padding="24,12"
                Margin="16"
                FontSize="13" />

    </Grid>

</ContentPage>
