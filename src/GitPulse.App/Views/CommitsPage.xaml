<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GitPulse.ViewModels;assembly=GitPulse.ViewModels"
             xmlns:models="clr-namespace:GitPulse.Core.Models;assembly=GitPulse.Core"
             x:Class="GitPulse.App.Views.CommitsPage"
             x:Name="_pageRoot"
             x:DataType="vm:CommitsViewModel"
             Title="Commits"
             AutomationId="CommitsPageRoot">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,Auto,*"
              ColumnSpacing="8"
              Padding="16,12,16,4">
            <Button Text="Back"
                    Clicked="OnBackClicked"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Primary}"
                    Padding="8,10"
                    VerticalOptions="Center" />
            <Label Grid.Column="1"
                   Text="Repos"
                   FontSize="14"
                   TextColor="{StaticResource Gray500}"
                   VerticalOptions="Center" />
            <Label Grid.Column="2"
                   Text="{Binding RepoFullName.Value}"
                   FontSize="14"
                   TextColor="{StaticResource Gray500}"
                   VerticalOptions="Center"
                   LineBreakMode="TailTruncation"
                   MaxLines="1" />
        </Grid>

        <Border Grid.Row="1"
                IsVisible="{Binding ErrorMessage.Value, Converter={StaticResource StringToBoolConverter}}"
                BackgroundColor="{StaticResource Red100}"
                StrokeShape="RoundRectangle 8"
                Padding="12"
                Margin="16,4,16,0">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <Label Text="{Binding ErrorMessage.Value}"
                       TextColor="{StaticResource Red900}"
                       FontSize="13"
                       LineBreakMode="WordWrap"
                       VerticalOptions="Center" />
                <Button Grid.Column="1"
                        Text="Retry"
                        Command="{Binding LoadCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Red900}"
                        Padding="8,10"
                        FontSize="13" />
                <Button Grid.Column="2"
                        Text="Back"
                        Clicked="OnBackClicked"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Red900}"
                        Padding="8,10"
                        FontSize="13" />
            </Grid>
        </Border>

        <CollectionView x:Name="CommitsList"
                        Grid.Row="2"
                        ItemsSource="{Binding Commits}"
                        RemainingItemsThreshold="5"
                        Margin="16,8,16,0">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:GitCommit">
                    <VerticalStackLayout Spacing="0">
                    <Grid ColumnDefinitions="Auto,*,Auto"
                          Padding="16,12"
                          MinimumHeightRequest="{OnPlatform Android=56, Default=48}"
                          ColumnSpacing="10">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCommitTapped"
                                                  CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>
                        <Image Source="git_commit_16.png"
                               WidthRequest="16"
                               HeightRequest="16"
                               VerticalOptions="Start"
                               Margin="0,2,0,0" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="{Binding Commit.Message}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="1" />
                            <Label FontSize="12"
                                   TextColor="{StaticResource Gray500}"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="1">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding Commit.Author.Name}" />
                                        <Span Text=" · " />
                                        <Span Text="{Binding Commit.Author.Date, StringFormat='{0:yyyy-MM-dd}'}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </VerticalStackLayout>
                        <Label Grid.Column="2"
                               Text="{Binding Sha, Converter={StaticResource StringTruncateConverter}, ConverterParameter=7}"
                               FontSize="12"
                               TextColor="{StaticResource Gray500}"
                               VerticalOptions="Start" />
                    </Grid>
                    <BoxView Style="{StaticResource Hairline}" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout Grid.Row="2"
                             IsVisible="{Binding Commits.Count, Converter={StaticResource IntGreaterThanZeroConverter}, ConverterParameter=invert}"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             Spacing="8"
                             Padding="16">

            <VerticalStackLayout.Triggers>
                <DataTrigger TargetType="VerticalStackLayout"
                             Binding="{Binding IsLoading.Value}"
                             Value="True">
                    <Setter Property="IsVisible" Value="False" />
                </DataTrigger>
            </VerticalStackLayout.Triggers>
            <Label Text="No commits"
                   FontSize="16"
                   TextColor="{StaticResource Gray500}"
                   HorizontalOptions="Center" />
            <Label Text="This branch has no commits to show."
                   FontSize="14"
                   TextColor="{StaticResource Gray400}"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>

        <ActivityIndicator Grid.Row="2"
                           IsRunning="{Binding IsLoading.Value}"
                           IsVisible="{Binding IsLoading.Value}"
                           VerticalOptions="Start"
                           Margin="0,16,0,0" />

        <Button Grid.Row="3"
                Text="Load more"
                Command="{Binding LoadMoreCommand}"
                IsVisible="{Binding CanLoadMore.Value}"
                HorizontalOptions="Fill"
                Padding="24,12"
                Margin="16"
                FontSize="13" />

    </Grid>

</ContentPage>
