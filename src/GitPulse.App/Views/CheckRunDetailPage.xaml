<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GitPulse.ViewModels;assembly=GitPulse.ViewModels"
             xmlns:models="clr-namespace:GitPulse.Core.Models;assembly=GitPulse.Core"
             xmlns:idk="clr-namespace:Indiko.Maui.Controls.Markdown;assembly=Indiko.Maui.Controls.Markdown"
             x:Class="GitPulse.App.Views.CheckRunDetailPage"
             x:DataType="vm:CheckRunDetailViewModel"
             Title="Check Run"
             AutomationId="CheckRunDetailPageRoot">

    <Grid RowDefinitions="Auto,*">
        <VerticalStackLayout Grid.Row="0" Spacing="4" Padding="16,8,16,4">
            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                <Button Text="Back"
                        Clicked="OnBackClicked"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Primary}"
                        Padding="8,10"
                        VerticalOptions="Center" />
                <Label Grid.Column="1"
                       Text="Checks"
                       FontSize="14"
                       TextColor="{StaticResource Gray500}"
                       VerticalOptions="Center" />
                <Label Grid.Column="2"
                       Text="{Binding RepoFullName.Value}"
                       FontSize="14"
                       TextColor="{StaticResource Gray500}"
                       VerticalOptions="Center"
                       LineBreakMode="TailTruncation"
                       MaxLines="1" />
            </Grid>
            <Label Text="{Binding Name.Value}"
                   FontSize="20"
                   FontAttributes="Bold"
                   LineBreakMode="WordWrap" />
            <Border IsVisible="{Binding ErrorMessage.Value, Converter={StaticResource StringToBoolConverter}}"
                    BackgroundColor="{StaticResource Red100}"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 8"
                    Padding="12"
                    Margin="0,8,0,0">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <Label Text="{Binding ErrorMessage.Value}"
                           TextColor="{StaticResource Red900}"
                           FontSize="13"
                           LineBreakMode="WordWrap"
                           VerticalOptions="Center" />
                    <Button Grid.Column="1"
                            Text="Retry"
                            Command="{Binding LoadCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource Red900}"
                            Padding="8,10"
                            FontSize="13" />
                    <Button Grid.Column="2"
                            Text="Back"
                            Clicked="OnBackClicked"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource Red900}"
                            Padding="8,10"
                            FontSize="13" />
                </Grid>
            </Border>
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="12">

                <ActivityIndicator IsRunning="{Binding IsLoading.Value}"
                                   IsVisible="{Binding IsLoading.Value}"
                                   HorizontalOptions="Center" />

                <Label Text="{Binding RepoFullName.Value}"
                       FontSize="13"
                       TextColor="{StaticResource Gray500}" />
                <HorizontalStackLayout Spacing="6">
                    <Image Source="check_circle_16.png"
                           WidthRequest="16"
                           HeightRequest="16"
                           VerticalOptions="Center" />
                    <Label Text="{Binding Conclusion.Value}"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="{Binding Conclusion.Value, Converter={StaticResource CheckConclusionColorConverter}}"
                           VerticalOptions="Center"
                           IsVisible="{Binding Conclusion.Value, Converter={StaticResource StringToBoolConverter}}" />
                    <Label Text="{Binding Status.Value}"
                           FontSize="12"
                           TextColor="{StaticResource Gray500}"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Label Text="{Binding OutputTitle.Value}"
                       FontSize="16"
                       FontAttributes="Bold"
                       IsVisible="{Binding OutputTitle.Value, Converter={StaticResource StringToBoolConverter}}" />
                <idk:MarkdownView MarkdownText="{Binding OutputSummary.Value}"
                                  UseAppTheme="True"
                                  TextFontSize="13"
                                  IsVisible="{Binding OutputSummary.Value, Converter={StaticResource StringToBoolConverter}}" />
                <idk:MarkdownView MarkdownText="{Binding OutputText.Value}"
                                  UseAppTheme="True"
                                  TextFontSize="13"
                                  IsVisible="{Binding OutputText.Value, Converter={StaticResource StringToBoolConverter}}" />
                <Label Text="Annotations"
                       FontSize="16"
                       FontAttributes="Bold"
                       Margin="0,8,0,0" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Annotations}"
                                     Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:CheckRunAnnotation">
                            <VerticalStackLayout Spacing="0">
                            <VerticalStackLayout Spacing="4" Padding="0,10" MinimumHeightRequest="{OnPlatform Android=56, Default=48}">
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnAnnotationTapped" />
                                </VerticalStackLayout.GestureRecognizers>
                                <Label Text="{Binding Path}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       LineBreakMode="MiddleTruncation"
                                       MaxLines="1" />
                                <Label FontSize="12"
                                       TextColor="{StaticResource Gray500}"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding AnnotationLevel}" />
                                            <Span Text=" · line " />
                                            <Span Text="{Binding StartLine}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Label Text="{Binding Message}"
                                       FontSize="13"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <BoxView Style="{StaticResource Hairline}" Margin="0" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <VerticalStackLayout
                        IsVisible="{Binding Annotations.Count, Converter={StaticResource IntGreaterThanZeroConverter}, ConverterParameter=invert}"
                        Spacing="4"
                        Padding="0,8">
                    <Label Text="No annotations"
                           FontSize="16"
                           TextColor="{StaticResource Gray500}"
                           HorizontalOptions="Center" />
                    <Label Text="This check did not report file annotations."
                           FontSize="14"
                           TextColor="{StaticResource Gray400}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
                <Button Text="Rerequest"
                        Command="{Binding RerequestCommand}"
                        IsEnabled="{Binding IsRerequesting.Value, Converter={StaticResource InvertedBoolConverter}}"
                        IsVisible="{Binding CheckRun.Value, Converter={StaticResource NotNullConverter}}"
                        Padding="16,12"
                        FontSize="13"
                        AutomationId="CheckRunRerequestButton" />
                <Button Text="Open GitHub"
                        Command="{Binding OpenInBrowserCommand}"
                        CommandParameter="{Binding HtmlUrl.Value}"
                        IsVisible="{Binding HtmlUrl.Value, Converter={StaticResource StringToBoolConverter}}"
                        Padding="16,12"
                        FontSize="13" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
