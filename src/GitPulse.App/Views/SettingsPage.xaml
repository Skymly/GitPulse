<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GitPulse.ViewModels;assembly=GitPulse.ViewModels"
             x:Class="GitPulse.App.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="Settings"
             AutomationId="SettingsPageRoot">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16" MaximumWidthRequest="600"
                              HorizontalOptions="Center"
                              VerticalOptions="Start">

            <Label Text="Account"
                   FontSize="20"
                   FontAttributes="Bold"
                   LineBreakMode="WordWrap" />

            <Label Text="Personal Access Token with repo scope. GitPulse stores it in the platform credential store."
                   FontSize="14"
                   TextColor="{StaticResource Gray500}"
                   LineBreakMode="WordWrap" />

            <Entry Placeholder="ghp_..."
                   IsPassword="True"
                   FontSize="14"
                   HorizontalOptions="Fill"
                   MinimumHeightRequest="44"
                   Text="{Binding TokenInput.Value}"
                   IsEnabled="{Binding IsBusy.Value, Converter={StaticResource InvertedBoolConverter}}"
                   AutomationId="SettingsTokenEntry" />

            <VerticalStackLayout Spacing="12">
                <Button Text="Save token"
                        Command="{Binding SaveTokenCommand}"
                        HorizontalOptions="Fill"
                        Padding="16,12"
                        IsEnabled="{Binding IsBusy.Value, Converter={StaticResource InvertedBoolConverter}}"
                        AutomationId="SettingsSaveTokenButton" />
                <Button Text="Clear token"
                        Command="{Binding ClearTokenCommand}"
                        HorizontalOptions="Fill"
                        Padding="16,12"
                        IsEnabled="{Binding HasToken.Value}"
                        BackgroundColor="{StaticResource Gray200}"
                        TextColor="{StaticResource Gray900}"
                        AutomationId="SettingsClearTokenButton" />
            </VerticalStackLayout>

            <Label Text="{Binding StatusMessage.Value}"
                   FontSize="14"
                   LineBreakMode="WordWrap"
                   IsVisible="{Binding StatusMessage.Value, Converter={StaticResource StringToBoolConverter}}"
                   AutomationId="SettingsStatusMessage" />

            <VerticalStackLayout Spacing="4"
                    IsVisible="{Binding HasToken.Value}"
                    HorizontalOptions="Fill"
                    AutomationId="SettingsTokenStoredBanner">
                <Label Text="A token is currently stored."
                       TextColor="{StaticResource Gray500}"
                       FontSize="14"
                       LineBreakMode="WordWrap" />
                <Label Text="{Binding ViewerLogin.Value, StringFormat='Signed in as {0}'}"
                       TextColor="{StaticResource Gray900}"
                       FontSize="14"
                       LineBreakMode="TailTruncation"
                       MaxLines="1"
                       IsVisible="{Binding ViewerLogin.Value, Converter={StaticResource StringToBoolConverter}}"
                       AutomationId="SettingsViewerLogin" />
            </VerticalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsBusy.Value}"
                               IsVisible="{Binding IsBusy.Value}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
