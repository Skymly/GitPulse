<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GitPulse.ViewModels;assembly=GitPulse.ViewModels"
             xmlns:models="clr-namespace:GitPulse.Core.Models;assembly=GitPulse.Core"
             xmlns:idk="clr-namespace:Indiko.Maui.Controls.Markdown;assembly=Indiko.Maui.Controls.Markdown"
             x:Class="GitPulse.App.Views.RepoDetailPage"
             x:DataType="vm:RepoDetailViewModel"
             Title="Repository"
             AutomationId="RepoDetailPageRoot">

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- Back + repo full name: Grid so long names truncate instead of clipping Back. -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,Auto,*"
              ColumnSpacing="8"
              Padding="16,12,16,4">
            <Button Text="Back"
                    Clicked="OnBackClicked"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Primary}"
                    Padding="8,10"
                    VerticalOptions="Center" />
            <Label Grid.Column="1"
                   Text="Repos"
                   FontSize="14"
                   TextColor="{StaticResource Gray500}"
                   VerticalOptions="Center" />
            <Label Grid.Column="2"
                   Text="{Binding RepoFullName.Value}"
                   FontSize="14"
                   TextColor="{StaticResource Gray500}"
                   VerticalOptions="Center"
                   LineBreakMode="TailTruncation"
                   MaxLines="1" />
        </Grid>

        <!-- Equal-width tabs stay tappable on narrow portrait widths. -->
        <Border Grid.Row="1"
                IsVisible="{Binding ErrorMessage.Value, Converter={StaticResource StringToBoolConverter}}"
                BackgroundColor="{StaticResource Red100}"
                Stroke="Transparent"
                StrokeShape="RoundRectangle 8"
                Padding="12"
                Margin="16,0,16,8">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                <Label Text="{Binding ErrorMessage.Value}"
                       TextColor="{StaticResource Red900}"
                       FontSize="13"
                       LineBreakMode="WordWrap"
                       VerticalOptions="Center" />
                <Button Grid.Column="1"
                        Text="Retry"
                        Command="{Binding LoadCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Red900}"
                        Padding="8,10"
                        FontSize="13" />
                <Button Grid.Column="2"
                        Text="Settings"
                        Clicked="OnOpenSettingsClicked"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Red900}"
                        Padding="8,10"
                        FontSize="13" />
                <Button Grid.Column="3"
                        Text="Back"
                        Clicked="OnBackClicked"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Red900}"
                        Padding="8,10"
                        FontSize="13" />
            </Grid>
        </Border>

        <Grid Grid.Row="2"
              ColumnDefinitions="*,*,*"
              ColumnSpacing="8"
              Padding="16,0,16,8">
            <Button x:Name="OverviewTab"
                    Grid.Column="0"
                    Text="Overview"
                    Clicked="OnOverviewTabClicked"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    Padding="8,10"
                    FontSize="13"
                    HorizontalOptions="Fill" />
            <Button x:Name="BranchesTab"
                    Grid.Column="1"
                    Text="Branches"
                    Clicked="OnBranchesTabClicked"
                    BackgroundColor="{StaticResource Gray200}"
                    TextColor="Black"
                    Padding="8,10"
                    FontSize="13"
                    HorizontalOptions="Fill" />
            <Button x:Name="ReleasesTab"
                    Grid.Column="2"
                    Text="Releases"
                    Clicked="OnReleasesTabClicked"
                    BackgroundColor="{StaticResource Gray200}"
                    TextColor="Black"
                    Padding="8,10"
                    FontSize="13"
                    HorizontalOptions="Fill" />
        </Grid>

        <!-- Tab content area -->
        <Grid Grid.Row="3">

            <!-- ── Overview tab ────────────────────────────────────── -->
            <ScrollView x:Name="OverviewSection">
                <VerticalStackLayout Padding="16" Spacing="12">

                    <!-- Repo metadata card -->
                    <VerticalStackLayout Spacing="8"
                             IsVisible="{Binding Repo.Value, Converter={StaticResource NotNullConverter}}">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label Grid.Column="0"
                                       Text="{Binding Repo.Value.Name}"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="2" />
                                <Label Grid.Column="1"
                                       Text="private"
                                       FontSize="11"
                                       TextColor="{StaticResource Gray500}"
                                       IsVisible="{Binding Repo.Value.Private}"
                                       VerticalOptions="Center" />
                            </Grid>

                            <Label Text="{Binding Repo.Value.Description}"
                                   FontSize="14"
                                   TextColor="{StaticResource Gray600}"
                                   LineBreakMode="WordWrap"
                                   IsVisible="{Binding Repo.Value.Description, Converter={StaticResource StringToBoolConverter}}" />

                            <HorizontalStackLayout Spacing="16" Margin="0,4,0,0">
                                <Label Text="{Binding StarCount.Value, StringFormat='★ {0}'}"
                                       FontSize="13"
                                       TextColor="{StaticResource Gray500}" />
                                <Label Text="{Binding Repo.Value.ForksCount, StringFormat='⑂ {0}'}"
                                       FontSize="13"
                                       TextColor="{StaticResource Gray500}" />
                                <Label Text="{Binding Repo.Value.OpenIssuesCount, StringFormat='⚠ {0}'}"
                                       FontSize="13"
                                       TextColor="{StaticResource Gray500}" />
                            </HorizontalStackLayout>
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                <Grid>
                                    <Button Text="Star"
                                            Command="{Binding ToggleStarCommand}"
                                            IsVisible="{Binding IsStarred.Value, Converter={StaticResource InvertedBoolConverter}}"
                                            IsEnabled="{Binding IsTogglingStar.Value, Converter={StaticResource InvertedBoolConverter}}"
                                            Padding="8,10"
                                            FontSize="13"
                                            HorizontalOptions="Fill"
                                            AutomationId="RepoDetailStarButton" />
                                    <Button Text="Unstar"
                                            Command="{Binding ToggleStarCommand}"
                                            IsVisible="{Binding IsStarred.Value}"
                                            IsEnabled="{Binding IsTogglingStar.Value, Converter={StaticResource InvertedBoolConverter}}"
                                            Padding="8,10"
                                            FontSize="13"
                                            HorizontalOptions="Fill"
                                            AutomationId="RepoDetailUnstarButton" />
                                </Grid>
                                <Grid Grid.Column="1">
                                    <Button Text="Watch"
                                            Command="{Binding ToggleWatchCommand}"
                                            IsVisible="{Binding IsWatching.Value, Converter={StaticResource InvertedBoolConverter}}"
                                            IsEnabled="{Binding IsTogglingWatch.Value, Converter={StaticResource InvertedBoolConverter}}"
                                            Padding="8,10"
                                            FontSize="13"
                                            HorizontalOptions="Fill"
                                            AutomationId="RepoDetailWatchButton" />
                                    <Button Text="Unwatch"
                                            Command="{Binding ToggleWatchCommand}"
                                            IsVisible="{Binding IsWatching.Value}"
                                            IsEnabled="{Binding IsTogglingWatch.Value, Converter={StaticResource InvertedBoolConverter}}"
                                            Padding="8,10"
                                            FontSize="13"
                                            HorizontalOptions="Fill"
                                            AutomationId="RepoDetailUnwatchButton" />
                                </Grid>
                                <Button Grid.Column="2"
                                        Text="Fork"
                                        Command="{Binding ForkCommand}"
                                        IsEnabled="{Binding IsForking.Value, Converter={StaticResource InvertedBoolConverter}}"
                                        Padding="8,10"
                                        FontSize="13"
                                        HorizontalOptions="Fill"
                                        AutomationId="RepoDetailForkButton" />
                            </Grid>
                            <Button Text="Open fork"
                                    Clicked="OnOpenForkClicked"
                                    IsVisible="{Binding ForkedFullName.Value, Converter={StaticResource StringToBoolConverter}}"
                                    Padding="16,10"
                                    FontSize="13"
                                    HorizontalOptions="Fill"
                                    AutomationId="RepoDetailOpenForkButton" />

                            <VerticalStackLayout Spacing="2" Margin="0,2,0,0">
                                <Label Text="{Binding Repo.Value.DefaultBranch, StringFormat='Default: {0}'}"
                                       FontSize="12"
                                       TextColor="{StaticResource Gray500}"
                                       LineBreakMode="TailTruncation" />
                                <Label Text="{Binding Repo.Value.UpdatedAt, StringFormat='Updated {0:yyyy-MM-dd}'}"
                                       FontSize="12"
                                       TextColor="{StaticResource Gray500}" />
                                <Label Text="{Binding Repo.Value.Language, StringFormat='Language: {0}'}"
                                       FontSize="12"
                                       TextColor="{StaticResource Gray500}"
                                       IsVisible="{Binding Repo.Value.Language, Converter={StaticResource StringToBoolConverter}}" />
                                <Label Text="{Binding Repo.Value.License.SpdxId, StringFormat='License: {0}'}"
                                       FontSize="12"
                                       TextColor="{StaticResource Gray500}"
                                       IsVisible="{Binding Repo.Value.License.SpdxId, Converter={StaticResource StringToBoolConverter}}" />
                                <Label Text="{Binding Repo.Value.Topics, Converter={StaticResource JoinStringsConverter}, StringFormat='Topics: {0}'}"
                                       FontSize="12"
                                       TextColor="{StaticResource Gray500}"
                                       LineBreakMode="TailTruncation"
                                       IsVisible="{Binding Repo.Value.Topics, Converter={StaticResource CollectionToBoolConverter}}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="4"
                                                 Margin="0,8,0,0"
                                                 IsVisible="{Binding Repo.Value.Homepage, Converter={StaticResource StringToBoolConverter}}">
                                <Label Text="Homepage"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Gray500}" />
                                <Label Text="{Binding Repo.Value.Homepage}"
                                       FontSize="12"
                                       LineBreakMode="MiddleTruncation"
                                       MaxLines="2" />
                                <Button Text="Open homepage"
                                        Command="{Binding OpenInBrowserCommand}"
                                        CommandParameter="{Binding Repo.Value.Homepage}"
                                        Padding="16,10"
                                        FontSize="13"
                                        HorizontalOptions="Fill"
                                        AutomationId="RepoDetailOpenHomepage" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="4"
                                                 Margin="0,8,0,0"
                                                 IsVisible="{Binding Repo.Value.CloneUrl, Converter={StaticResource StringToBoolConverter}}">
                                <Label Text="Clone"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Gray500}" />
                                <Label Text="{Binding Repo.Value.CloneUrl}"
                                       FontSize="12"
                                       LineBreakMode="MiddleTruncation"
                                       MaxLines="2" />
                                <Button Text="Copy HTTPS"
                                        Clicked="OnCopyCloneUrlClicked"
                                        Padding="16,10"
                                        FontSize="13"
                                        HorizontalOptions="Fill"
                                        AutomationId="RepoDetailCopyCloneUrl" />
                                <Label x:Name="CloneCopiedLabel"
                                       Text="Copied."
                                       FontSize="12"
                                       TextColor="{StaticResource Gray500}"
                                       IsVisible="False" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <!-- GitHub-style repo destinations: equal segments, not a stacked list. -->
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*,*" ColumnSpacing="8" RowSpacing="8">
                        <Button Text="Issues"
                                Clicked="OnIssuesClicked"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="White"
                                Padding="8,12"
                                FontSize="13"
                                HorizontalOptions="Fill"
                                AutomationId="RepoDetailIssuesButton" />
                        <Button Grid.Column="1"
                                Text="PRs"
                                Clicked="OnPullRequestsClicked"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource Primary}"
                                Padding="8,12"
                                FontSize="13"
                                HorizontalOptions="Fill"
                                AutomationId="RepoDetailPrsButton" />
                        <Button Grid.Column="2"
                                Text="Commits"
                                Clicked="OnCommitsClicked"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource Primary}"
                                Padding="8,12"
                                FontSize="13"
                                HorizontalOptions="Fill"
                                AutomationId="RepoDetailCommitsButton" />
                        <Button Grid.Row="1"
                                Text="Files"
                                Clicked="OnFilesClicked"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource Primary}"
                                Padding="8,12"
                                FontSize="13"
                                HorizontalOptions="Fill" />
                        <Button Grid.Row="1"
                                Grid.Column="1"
                                Text="Actions"
                                Clicked="OnActionsClicked"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource Primary}"
                                Padding="8,12"
                                FontSize="13"
                                HorizontalOptions="Fill"
                                AutomationId="RepoDetailActionsButton" />
                        <Button Grid.Row="1"
                                Grid.Column="2"
                                Text="Browser"
                                Command="{Binding OpenInBrowserCommand}"
                                CommandParameter="{Binding Repo.Value.HtmlUrl}"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource Primary}"
                                Padding="8,12"
                                FontSize="13"
                                HorizontalOptions="Fill" />
                    </Grid>

                    <!-- README section -->
                    <Label Text="README"
                           FontSize="16"
                           FontAttributes="Bold"
                           Margin="0,8,0,4"
                           IsVisible="{Binding HasReadme.Value}" />

                    <idk:MarkdownView MarkdownText="{Binding ReadmeMarkdown.Value}"
                                      UseAppTheme="True"
                                      H1FontSize="20"
                                      H2FontSize="18"
                                      H3FontSize="16"
                                      TextFontSize="14"
                                      IsVisible="{Binding HasReadme.Value}" />

                    <VerticalStackLayout
                             IsVisible="{Binding HasReadme.Value, Converter={StaticResource InvertedBoolConverter}}"
                             Spacing="4"
                             Padding="0,8">
                        <Label Text="No README"
                               FontSize="16"
                               TextColor="{StaticResource Gray500}"
                               HorizontalOptions="Center" />
                        <Label Text="This repository has no README to show."
                               FontSize="14"
                               TextColor="{StaticResource Gray400}"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>


                    <!-- Loading indicator -->
                    <ActivityIndicator IsRunning="{Binding IsLoading.Value}"
                                       IsVisible="{Binding IsLoading.Value}" />
                </VerticalStackLayout>
            </ScrollView>

            <!-- ── Branches tab ────────────────────────────────────── -->
            <ScrollView x:Name="BranchesSection" IsVisible="False">
                <VerticalStackLayout Padding="16" Spacing="8">
                    <ActivityIndicator IsRunning="{Binding IsLoadingBranches.Value}"
                                       IsVisible="{Binding IsLoadingBranches.Value}" />
                    <CollectionView ItemsSource="{Binding Branches}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Branch">
                                <VerticalStackLayout Spacing="0">
                                <Grid ColumnDefinitions="*,Auto"
                                      Padding="4,12"
                                      MinimumHeightRequest="{OnPlatform Android=56, Default=48}"
                                      ColumnSpacing="8">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding Name}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="1" />
                                        <Label Text="{Binding Commit.Sha, Converter={StaticResource StringTruncateConverter}, ConverterParameter=8}"
                                               FontSize="12"
                                               TextColor="{StaticResource Gray500}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1"
                                           Text="protected"
                                           FontSize="12"
                                           TextColor="{StaticResource Gray500}"
                                           IsVisible="{Binding Protected}"
                                           VerticalOptions="Center" />
                                </Grid>
                                <BoxView Style="{StaticResource Hairline}" Margin="0" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <VerticalStackLayout
                             IsVisible="{Binding Branches.Count, Converter={StaticResource IntGreaterThanZeroConverter}, ConverterParameter=invert}"
                             Spacing="4"
                             Padding="0,16">
                        <Label Text="No branches"
                               FontSize="16"
                               TextColor="{StaticResource Gray500}"
                               HorizontalOptions="Center" />
                        <Label Text="This repository has no branches to list."
                               FontSize="14"
                               TextColor="{StaticResource Gray400}"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>

            <!-- ── Releases tab ────────────────────────────────────── -->
            <ScrollView x:Name="ReleasesSection" IsVisible="False">
                <VerticalStackLayout Padding="16" Spacing="8">
                    <ActivityIndicator IsRunning="{Binding IsLoadingReleases.Value}"
                                       IsVisible="{Binding IsLoadingReleases.Value}" />
                    <CollectionView ItemsSource="{Binding Releases}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Release">
                                <VerticalStackLayout Spacing="0">
                                <Grid ColumnDefinitions="*,Auto"
                                      Padding="4,12"
                                      MinimumHeightRequest="{OnPlatform Android=56, Default=48}"
                                      ColumnSpacing="8">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding TagName}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="1" />
                                        <Label FontSize="12"
                                               TextColor="{StaticResource Gray500}"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="1">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding Name}" />
                                                    <Span Text=" · " />
                                                    <Span Text="{Binding Author.Login}" />
                                                    <Span Text=" · " />
                                                    <Span Text="{Binding PublishedAt, StringFormat='{0:yyyy-MM-dd}'}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="Draft"
                                               FontSize="12"
                                               TextColor="{StaticResource Gray500}"
                                               IsVisible="{Binding Draft}"
                                               HorizontalOptions="End" />
                                        <Label Text="Pre-release"
                                               FontSize="12"
                                               TextColor="{StaticResource Gray500}"
                                               IsVisible="{Binding Prerelease}"
                                               HorizontalOptions="End" />
                                    </VerticalStackLayout>
                                </Grid>
                                <BoxView Style="{StaticResource Hairline}" Margin="0" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <VerticalStackLayout
                             IsVisible="{Binding Releases.Count, Converter={StaticResource IntGreaterThanZeroConverter}, ConverterParameter=invert}"
                             Spacing="4"
                             Padding="0,16">
                        <Label Text="No releases"
                               FontSize="16"
                               TextColor="{StaticResource Gray500}"
                               HorizontalOptions="Center" />
                        <Label Text="This repository has no releases yet."
                               FontSize="14"
                               TextColor="{StaticResource Gray400}"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>

        </Grid>

    </Grid>

</ContentPage>
