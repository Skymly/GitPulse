<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GitPulse.ViewModels;assembly=GitPulse.ViewModels"
             xmlns:models="clr-namespace:GitPulse.Core.Models;assembly=GitPulse.Core"
             x:Class="GitPulse.App.Views.PullRequestsPage"
             x:DataType="vm:PullRequestsViewModel"
             Title="Pull Requests"
             AutomationId="PullRequestsPageRoot">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

        <!-- Back + repo name: Grid so long names truncate instead of clipping Back. -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,Auto,*"
              ColumnSpacing="8"
              Padding="16,12,16,4">
            <Button Text="Back"
                    Clicked="OnBackClicked"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Primary}"
                    Padding="8,10"
                    VerticalOptions="Center"
                    AutomationId="PullRequestsBackButton" />
            <Label Grid.Column="1"
                   Text="Repos"
                   FontSize="14"
                   TextColor="{StaticResource Gray500}"
                   VerticalOptions="Center" />
            <Label Grid.Column="2"
                   Text="{Binding RepoFullName.Value}"
                   FontSize="14"
                   TextColor="{StaticResource Gray500}"
                   VerticalOptions="Center"
                   LineBreakMode="TailTruncation"
                   MaxLines="1" />
        </Grid>

        <VerticalStackLayout Grid.Row="1" Spacing="8" Padding="16,0,16,8">
            <Button Text="+ New pull request"
                    Clicked="OnNewPullRequestClicked"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    Padding="16,12"
                    FontSize="13"
                    HorizontalOptions="Fill" />
        </VerticalStackLayout>

        <!-- Equal-width filter tabs stay tappable on narrow portrait widths. -->
        <Grid Grid.Row="2"
              ColumnDefinitions="*,*,*"
              ColumnSpacing="8"
              Padding="16,0,16,8">
            <Button Text="Open"
                    Clicked="OnFilterOpen"
                    x:Name="OpenTab"
                    Grid.Column="0"
                    Padding="8,10"
                    FontSize="13"
                    HorizontalOptions="Fill" />
            <Button Text="Closed"
                    Clicked="OnFilterClosed"
                    x:Name="ClosedTab"
                    Grid.Column="1"
                    Padding="8,10"
                    FontSize="13"
                    HorizontalOptions="Fill" />
            <Button Text="All"
                    Clicked="OnFilterAll"
                    x:Name="AllTab"
                    Grid.Column="2"
                    Padding="8,10"
                    FontSize="13"
                    HorizontalOptions="Fill" />
        </Grid>

        <!-- Error banner -->
        <Border Grid.Row="3"
                IsVisible="{Binding ErrorMessage.Value, Converter={StaticResource StringToBoolConverter}}"
                BackgroundColor="{StaticResource Red100}"
                StrokeShape="RoundRectangle 8"
                Padding="12"
                Margin="16,4,16,0">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <Label Text="{Binding ErrorMessage.Value}"
                       TextColor="{StaticResource Red900}"
                       FontSize="13"
                       LineBreakMode="WordWrap"
                       VerticalOptions="Center" />
                <Button Grid.Column="1"
                        Text="Retry"
                        Command="{Binding LoadCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Red900}"
                        Padding="8,10"
                        FontSize="13" />
                <Button Grid.Column="2"
                        Text="Back"
                        Clicked="OnBackClicked"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Red900}"
                        Padding="8,10"
                        FontSize="13" />
            </Grid>
        </Border>

        <RefreshView x:Name="ListRefresh"
                     Grid.Row="4"
                     Command="{Binding LoadCommand}"
                     IsRefreshing="{Binding IsLoading.Value}">
            <CollectionView x:Name="PullRequestsList"
                            ItemsSource="{Binding PullRequests}"
                            SelectionMode="Single"
                            RemainingItemsThreshold="5"
                            SelectionChanged="OnPrSelected">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:PullRequest">
                        <VerticalStackLayout Spacing="0">
                        <Grid ColumnDefinitions="Auto,*,Auto"
                              Padding="16,12"
                              MinimumHeightRequest="{OnPlatform Android=56, Default=48}"
                              ColumnSpacing="10">
                            <Image Source="{Binding ., Converter={StaticResource PullRequestIconConverter}}"
                                   WidthRequest="16"
                                   HeightRequest="16"
                                   VerticalOptions="Start"
                                   Margin="0,2,0,0" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="{Binding Title}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1" />
                                <Label FontSize="12"
                                       TextColor="{StaticResource Gray500}"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding ., Converter={StaticResource PullRequestStateTextConverter}}" />
                                            <Span Text=" · " />
                                            <Span Text="{Binding Head.Ref}" />
                                            <Span Text=" → " />
                                            <Span Text="{Binding Base.Ref}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </VerticalStackLayout>
                            <Label Grid.Column="2"
                                   Text="{Binding Number, StringFormat='#{0}'}"
                                   FontSize="12"
                                   TextColor="{StaticResource Gray500}"
                                   VerticalOptions="Start" />
                        </Grid>
                        <BoxView Style="{StaticResource Hairline}" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
        <VerticalStackLayout Grid.Row="4"
                             IsVisible="{Binding IsLoading.Value, Converter={StaticResource InvertedBoolConverter}}"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             Padding="16"
                             Spacing="8">
            <VerticalStackLayout IsVisible="{Binding PullRequests.Count, Converter={StaticResource IntGreaterThanZeroConverter}, ConverterParameter=invert}"
                                 Spacing="8"
                                 HorizontalOptions="Center">
                <Label Text="No pull requests"
                       FontSize="16"
                       TextColor="{StaticResource Gray500}"
                       HorizontalOptions="Center" />
                <Label Text="Nothing matches this filter."
                       FontSize="14"
                       TextColor="{StaticResource Gray400}"
                       HorizontalOptions="Center" />
                <Button Text="+ New pull request"
                        Clicked="OnNewPullRequestClicked"
                        Padding="16,12"
                        FontSize="13"
                        HorizontalOptions="Center" />
            </VerticalStackLayout>
        </VerticalStackLayout>

        <!-- Loading + load more -->
        <VerticalStackLayout Grid.Row="5" Padding="16" Spacing="8">
            <ActivityIndicator IsRunning="{Binding IsLoading.Value}"
                               IsVisible="{Binding IsLoading.Value}" />
            <Button Text="Load more"
                    Command="{Binding LoadMoreCommand}"
                    IsVisible="{Binding CanLoadMore.Value}"
                    HorizontalOptions="Fill"
                    Padding="24,12"
                    FontSize="13" />
        </VerticalStackLayout>

    </Grid>

</ContentPage>
