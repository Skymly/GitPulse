<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GitPulse.ViewModels;assembly=GitPulse.ViewModels"
             xmlns:models="clr-namespace:GitPulse.Core.Models;assembly=GitPulse.Core"
             x:Class="GitPulse.App.Views.PullRequestsPage"
             x:DataType="vm:PullRequestsViewModel"
             Title="Pull Requests">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!-- Back + repo name: Grid so long names truncate instead of clipping Back. -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*"
              ColumnSpacing="12"
              Padding="16,12,16,4">
            <Button Grid.Column="0"
                    Text="← Back"
                    Clicked="OnBackClicked"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Primary}"
                    Padding="8,4"
                    VerticalOptions="Center" />
            <Label Grid.Column="1"
                   Text="{Binding RepoFullName.Value}"
                   FontSize="18"
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   LineBreakMode="TailTruncation"
                   MaxLines="1" />
        </Grid>

        <!-- Equal-width filter tabs stay tappable on narrow portrait widths. -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,*,*"
              ColumnSpacing="8"
              Padding="16,0,16,8">
            <Button Text="Open"
                    Clicked="OnFilterOpen"
                    x:Name="OpenTab"
                    Grid.Column="0"
                    Padding="8,10"
                    FontSize="13"
                    HorizontalOptions="Fill" />
            <Button Text="Closed"
                    Clicked="OnFilterClosed"
                    x:Name="ClosedTab"
                    Grid.Column="1"
                    Padding="8,10"
                    FontSize="13"
                    HorizontalOptions="Fill" />
            <Button Text="All"
                    Clicked="OnFilterAll"
                    x:Name="AllTab"
                    Grid.Column="2"
                    Padding="8,10"
                    FontSize="13"
                    HorizontalOptions="Fill" />
        </Grid>

        <!-- Error banner -->
        <Border Grid.Row="2"
                IsVisible="{Binding ErrorMessage.Value, Converter={StaticResource StringToBoolConverter}}"
                BackgroundColor="{StaticResource Red100}"
                StrokeShape="RoundRectangle 8"
                Padding="12"
                Margin="16,4,16,0">
            <Label Text="{Binding ErrorMessage.Value}"
                   TextColor="{StaticResource Red900}"
                   FontSize="13"
                   LineBreakMode="WordWrap" />
        </Border>

        <!-- Pull requests list -->
        <CollectionView Grid.Row="3"
                        ItemsSource="{Binding PullRequests}"
                        Margin="16,8,16,0"
                        SelectionMode="Single"
                        SelectionChanged="OnPrSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:PullRequest">
                    <!-- Minimum height keeps portrait tap targets usable. -->
                    <Border Margin="0,0,0,8"
                            Padding="14,16"
                            MinimumHeightRequest="56"
                            StrokeShape="RoundRectangle 8"
                            Stroke="{StaticResource Gray200}">
                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                                <Label Grid.Column="0"
                                       Text="#"
                                       FontSize="14"
                                       TextColor="{StaticResource Gray500}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="{Binding Number}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="2"
                                       Text="{Binding Title}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="2"
                                       VerticalOptions="Center" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="8" Margin="0,2,0,0">
                                <Label Grid.Column="0"
                                       Text="{Binding State}"
                                       FontSize="11"
                                       TextColor="{StaticResource Green700}"
                                       IsVisible="{Binding State, Converter={StaticResource StringEqualsConverter}, ConverterParameter=open}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="0"
                                       Text="{Binding State}"
                                       FontSize="11"
                                       TextColor="{StaticResource Purple700}"
                                       IsVisible="{Binding State, Converter={StaticResource StringEqualsConverter}, ConverterParameter=closed}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="draft"
                                       FontSize="11"
                                       FontAttributes="Italic"
                                       TextColor="{StaticResource Orange900}"
                                       IsVisible="{Binding Draft}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="2"
                                       Text="merged"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Purple700}"
                                       IsVisible="{Binding Merged}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="3"
                                       Text="{Binding User.Login, StringFormat='by {0}'}"
                                       FontSize="11"
                                       TextColor="{StaticResource Gray500}"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1"
                                       VerticalOptions="Center"
                                       HorizontalOptions="End" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="8" Margin="0,2,0,0">
                                <Label Grid.Column="0"
                                       Text="{Binding HeadRef}"
                                       FontSize="11"
                                       TextColor="{StaticResource Gray600}"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="→"
                                       FontSize="11"
                                       TextColor="{StaticResource Gray500}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="2"
                                       Text="{Binding BaseRef}"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Gray600}"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1"
                                       VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Loading + load more -->
        <VerticalStackLayout Grid.Row="4" Padding="16" Spacing="8">
            <ActivityIndicator IsRunning="{Binding IsLoading.Value}"
                               IsVisible="{Binding IsLoading.Value}" />
            <Button Text="Load more"
                    Command="{Binding LoadMoreCommand}"
                    IsVisible="{Binding CanLoadMore.Value}"
                    HorizontalOptions="Fill"
                    Padding="24,12"
                    FontSize="13" />
        </VerticalStackLayout>

    </Grid>

</ContentPage>
