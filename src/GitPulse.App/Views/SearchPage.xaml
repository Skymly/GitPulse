<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GitPulse.ViewModels;assembly=GitPulse.ViewModels"
             xmlns:models="clr-namespace:GitPulse.Core.Models;assembly=GitPulse.Core"
             x:Class="GitPulse.App.Views.SearchPage"
             x:DataType="vm:SearchViewModel"
             Title="Search"
             AutomationId="SearchPageRoot">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Padding="16,12">
        <!-- M20/M29/M37: Search / Review requested / Assigned / Mentions. -->
        <Grid Grid.Row="0" ColumnDefinitions="*,*,*,*" ColumnSpacing="6" Margin="0,0,0,8">
            <Button x:Name="SearchHubButton"
                    Text="Search"
                    Clicked="OnSearchHubClicked"
                    Padding="4,10"
                    FontSize="12"
                    HorizontalOptions="Fill"
                    AutomationId="SearchSearchHub" />
            <Button x:Name="ReviewRequestedHubButton"
                    Grid.Column="1"
                    Text="Review"
                    Clicked="OnReviewRequestedHubClicked"
                    Padding="4,10"
                    FontSize="12"
                    HorizontalOptions="Fill"
                    AutomationId="SearchReviewRequestedHub" />
            <Button x:Name="AssignedHubButton"
                    Grid.Column="2"
                    Text="Assigned"
                    Clicked="OnAssignedHubClicked"
                    Padding="4,10"
                    FontSize="12"
                    HorizontalOptions="Fill"
                    AutomationId="SearchAssignedHub" />
            <Button x:Name="MentionsHubButton"
                    Grid.Column="3"
                    Text="Mentions"
                    Clicked="OnMentionsHubClicked"
                    Padding="4,10"
                    FontSize="12"
                    HorizontalOptions="Fill"
                    AutomationId="SearchMentionsHub" />
        </Grid>
        <!-- Search field + button share the row; long queries truncate in the bar. -->
        <VerticalStackLayout Grid.Row="1" Spacing="4" IsVisible="{Binding IsSearchHub.Value}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <SearchBar x:Name="SearchBar"
                           Grid.Column="0"
                           Placeholder="Search GitHub..."
                           SearchButtonPressed="OnSearchSubmitted"
                           HorizontalOptions="Fill" />
                <Button Grid.Column="1"
                        Text="Search"
                        Clicked="OnSearchClicked"
                        Padding="16,10"
                        VerticalOptions="Center"
                        AutomationId="SearchSubmitButton" />
            </Grid>
            <Label x:Name="QueryFieldError"
                   Text="Enter at least 3 characters."
                   TextColor="{StaticResource Red900}"
                   FontSize="12"
                   IsVisible="False" />
        </VerticalStackLayout>

        <!-- Equal-width type tabs stay tappable on narrow portrait widths. -->
        <Grid Grid.Row="2"
              ColumnDefinitions="*,*,*,*"
              ColumnSpacing="6"
              Margin="0,8"
              IsVisible="{Binding IsSearchHub.Value}">
            <Button x:Name="RepositoriesTab"
                    Grid.Column="0"
                    Text="Repos"
                    Clicked="OnRepositoriesClicked"
                    FontSize="12"
                    Padding="4,10"
                    HorizontalOptions="Fill" />
            <Button x:Name="IssuesTab"
                    Grid.Column="1"
                    Text="Issues"
                    Clicked="OnIssuesClicked"
                    FontSize="12"
                    Padding="4,10"
                    HorizontalOptions="Fill" />
            <Button x:Name="PullRequestsTab"
                    Grid.Column="2"
                    Text="PRs"
                    Clicked="OnPullRequestsClicked"
                    FontSize="12"
                    Padding="4,10"
                    HorizontalOptions="Fill" />
            <Button x:Name="CodeTab"
                    Grid.Column="3"
                    Text="Code"
                    Clicked="OnCodeClicked"
                    FontSize="12"
                    Padding="4,10"
                    HorizontalOptions="Fill" />
        </Grid>

        <VerticalStackLayout Grid.Row="3" Spacing="6">
            <Border IsVisible="{Binding ErrorMessage.Value, Converter={StaticResource StringToBoolConverter}}"
                    BackgroundColor="{StaticResource Red100}"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 8"
                    Padding="12">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Label Text="{Binding ErrorMessage.Value}"
                           TextColor="{StaticResource Red900}"
                           FontSize="13"
                           LineBreakMode="WordWrap"
                           VerticalOptions="Center" />
                    <Button Grid.Column="1"
                            Text="Settings"
                            Clicked="OnOpenSettingsClicked"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource Red900}"
                            Padding="8,10"
                            FontSize="13" />
                </Grid>
            </Border>
            <Label Text="{Binding TotalCount.Value, StringFormat='{}{0:N0} results'}"
                   IsVisible="{Binding HasSearched.Value}"
                   FontSize="12"
                   TextColor="{StaticResource Gray500}" />
            <VerticalStackLayout IsVisible="{Binding IsEmpty.Value}"
                                 Spacing="4"
                                 Margin="0,16"
                                 HorizontalOptions="Center">
                <VerticalStackLayout IsVisible="{Binding IsSearchHub.Value}"
                                     Spacing="4">
                    <Label Text="No results"
                           FontSize="16"
                           TextColor="{StaticResource Gray500}"
                           HorizontalOptions="Center" />
                    <Label Text="Try another query, or open Review / Assigned / Mentions."
                           FontSize="14"
                           TextColor="{StaticResource Gray400}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
                <VerticalStackLayout IsVisible="{Binding IsReviewRequestedHub.Value}"
                                     Spacing="4">
                    <Label Text="No review requests"
                           FontSize="16"
                           TextColor="{StaticResource Gray500}"
                           HorizontalOptions="Center" />
                    <Label Text="Pull requests waiting for your review will show up here."
                           FontSize="14"
                           TextColor="{StaticResource Gray400}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
                <VerticalStackLayout IsVisible="{Binding IsAssignedHub.Value}"
                                     Spacing="4">
                    <Label Text="Nothing assigned"
                           FontSize="16"
                           TextColor="{StaticResource Gray500}"
                           HorizontalOptions="Center" />
                    <Label Text="Issues and pull requests assigned to you will show up here."
                           FontSize="14"
                           TextColor="{StaticResource Gray400}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
                <VerticalStackLayout IsVisible="{Binding IsMentionsHub.Value}"
                                     Spacing="4">
                    <Label Text="No mentions"
                           FontSize="16"
                           TextColor="{StaticResource Gray500}"
                           HorizontalOptions="Center" />
                    <Label Text="Conversations that mention you will show up here."
                           FontSize="14"
                           TextColor="{StaticResource Gray400}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </VerticalStackLayout>

        <RefreshView x:Name="ListRefresh" Grid.Row="4" IsRefreshing="{Binding IsLoading.Value}">
        <Grid>
        <CollectionView x:Name="RepositoriesList"
                        ItemsSource="{Binding Repositories}"
                        IsVisible="{Binding IsRepositoriesSelected.Value}"
                        RemainingItemsThreshold="5"
                        SelectionMode="Single"
                        SelectionChanged="OnRepositorySelected">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Repo">
                    <VerticalStackLayout Spacing="0">
                    <Grid Padding="4,12" MinimumHeightRequest="{OnPlatform Android=56, Default=48}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding FullName}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="1" />
                            <Label Text="{Binding Description}"
                                   FontSize="13"
                                   MaxLines="2"
                                   LineBreakMode="TailTruncation"
                                   TextColor="{StaticResource Gray600}" />
                            <Label Text="{Binding StargazersCount, StringFormat='★ {0:N0}'}"
                                   FontSize="12"
                                   TextColor="{StaticResource Gray500}" />
                        </VerticalStackLayout>
                    </Grid>
                    <BoxView Style="{StaticResource Hairline}" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <CollectionView x:Name="IssuesList"
                        ItemsSource="{Binding Issues}"
                        IsVisible="{Binding IsIssuesSelected.Value}"
                        RemainingItemsThreshold="5"
                        SelectionMode="Single"
                        SelectionChanged="OnIssueSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:SearchIssueItem">
                    <VerticalStackLayout Spacing="0">
                    <Grid Padding="4,12" MinimumHeightRequest="{OnPlatform Android=56, Default=48}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Title}"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   MaxLines="2"
                                   LineBreakMode="TailTruncation" />
                            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                                <Label Grid.Column="0"
                                       Text="{Binding Number, StringFormat='#{0}'}"
                                       FontSize="12"
                                       TextColor="{StaticResource Gray500}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="{Binding State}"
                                       FontSize="12"
                                       TextColor="{StaticResource Gray500}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="2"
                                       Text="{Binding User.Login}"
                                       FontSize="12"
                                       TextColor="{StaticResource Gray500}"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1"
                                       VerticalOptions="Center"
                                       HorizontalOptions="End" />
                            </Grid>
                        </VerticalStackLayout>
                    </Grid>
                    <BoxView Style="{StaticResource Hairline}" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <CollectionView x:Name="PullRequestsList"
                        ItemsSource="{Binding PullRequests}"
                        IsVisible="{Binding IsPullRequestsSelected.Value}"
                        RemainingItemsThreshold="5"
                        SelectionMode="Single"
                        SelectionChanged="OnPullRequestSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:SearchIssueItem">
                    <VerticalStackLayout Spacing="0">
                    <Grid Padding="4,12" MinimumHeightRequest="{OnPlatform Android=56, Default=48}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Title}"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   MaxLines="2"
                                   LineBreakMode="TailTruncation" />
                            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                                <Label Grid.Column="0"
                                       Text="{Binding Number, StringFormat='#{0}'}"
                                       FontSize="12"
                                       TextColor="{StaticResource Gray500}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="{Binding State}"
                                       FontSize="12"
                                       TextColor="{StaticResource Gray500}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="2"
                                       Text="{Binding User.Login}"
                                       FontSize="12"
                                       TextColor="{StaticResource Gray500}"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1"
                                       VerticalOptions="Center"
                                       HorizontalOptions="End" />
                            </Grid>
                        </VerticalStackLayout>
                    </Grid>
                    <BoxView Style="{StaticResource Hairline}" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <CollectionView x:Name="CodeList"
                        ItemsSource="{Binding CodeResults}"
                        IsVisible="{Binding IsCodeSelected.Value}"
                        RemainingItemsThreshold="5"
                        SelectionMode="Single"
                        SelectionChanged="OnCodeSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:CodeSearchItem">
                    <VerticalStackLayout Spacing="0">
                    <Grid Padding="4,12" MinimumHeightRequest="{OnPlatform Android=56, Default=48}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Repository.FullName}"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="1" />
                            <Label Text="{Binding Path}"
                                   FontSize="14"
                                   LineBreakMode="MiddleTruncation"
                                   MaxLines="1" />
                            <Label Text="{Binding Sha}"
                                   FontSize="11"
                                   MaxLines="1"
                                   LineBreakMode="TailTruncation"
                                   TextColor="{StaticResource Gray500}" />
                        </VerticalStackLayout>
                    </Grid>
                    <BoxView Style="{StaticResource Hairline}" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <CollectionView x:Name="ReviewRequestedList"
                        ItemsSource="{Binding ReviewRequested}"
                        IsVisible="{Binding IsReviewRequestedSelected.Value}"
                        RemainingItemsThreshold="5"
                        SelectionMode="Single"
                        SelectionChanged="OnReviewRequestedSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:SearchIssueItem">
                    <VerticalStackLayout Spacing="0">
                    <Grid Padding="4,12" MinimumHeightRequest="{OnPlatform Android=56, Default=48}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding RepositoryFullName}"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="1" />
                            <Label Text="{Binding Title}"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   MaxLines="2"
                                   LineBreakMode="TailTruncation" />
                            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                                <Label Grid.Column="0"
                                       Text="{Binding Number, StringFormat='#{0}'}"
                                       FontSize="12"
                                       TextColor="{StaticResource Gray500}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="{Binding State}"
                                       FontSize="12"
                                       TextColor="{StaticResource Gray500}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="2"
                                       Text="{Binding User.Login}"
                                       FontSize="12"
                                       TextColor="{StaticResource Gray500}"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1"
                                       VerticalOptions="Center"
                                       HorizontalOptions="End" />
                            </Grid>
                        </VerticalStackLayout>
                    </Grid>
                    <BoxView Style="{StaticResource Hairline}" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <CollectionView x:Name="AssignedList"
                        ItemsSource="{Binding Assigned}"
                        IsVisible="{Binding IsAssignedSelected.Value}"
                        RemainingItemsThreshold="5"
                        SelectionMode="Single"
                        SelectionChanged="OnAssignedSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:SearchIssueItem">
                    <VerticalStackLayout Spacing="0">
                    <Grid Padding="4,12" MinimumHeightRequest="{OnPlatform Android=56, Default=48}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding RepositoryFullName}"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="1" />
                            <Label Text="{Binding Title}"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   MaxLines="2"
                                   LineBreakMode="TailTruncation" />
                            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                                <Label Grid.Column="0"
                                       Text="{Binding Number, StringFormat='#{0}'}"
                                       FontSize="12"
                                       TextColor="{StaticResource Gray500}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="{Binding State}"
                                       FontSize="12"
                                       TextColor="{StaticResource Gray500}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="2"
                                       Text="{Binding User.Login}"
                                       FontSize="12"
                                       TextColor="{StaticResource Gray500}"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1"
                                       VerticalOptions="Center"
                                       HorizontalOptions="End" />
                            </Grid>
                        </VerticalStackLayout>
                    </Grid>
                    <BoxView Style="{StaticResource Hairline}" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <CollectionView x:Name="MentionsList"
                        ItemsSource="{Binding Mentions}"
                        IsVisible="{Binding IsMentionsSelected.Value}"
                        RemainingItemsThreshold="5"
                        SelectionMode="Single"
                        SelectionChanged="OnAssignedSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:SearchIssueItem">
                    <VerticalStackLayout Spacing="0">
                    <Grid Padding="4,12" MinimumHeightRequest="{OnPlatform Android=56, Default=48}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding RepositoryFullName}"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="1" />
                            <Label Text="{Binding Title}"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   MaxLines="2"
                                   LineBreakMode="TailTruncation" />
                            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                                <Label Grid.Column="0"
                                       Text="{Binding Number, StringFormat='#{0}'}"
                                       FontSize="12"
                                       TextColor="{StaticResource Gray500}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="{Binding State}"
                                       FontSize="12"
                                       TextColor="{StaticResource Gray500}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="2"
                                       Text="{Binding User.Login}"
                                       FontSize="12"
                                       TextColor="{StaticResource Gray500}"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1"
                                       VerticalOptions="Center"
                                       HorizontalOptions="End" />
                            </Grid>
                        </VerticalStackLayout>
                    </Grid>
                    <BoxView Style="{StaticResource Hairline}" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        </Grid>
        </RefreshView>
        <VerticalStackLayout Grid.Row="5" Spacing="8" Padding="0,8,0,0">
            <ActivityIndicator IsRunning="{Binding IsLoading.Value}"
                               IsVisible="{Binding IsLoading.Value}" />
            <Button Text="Load more"
                    Command="{Binding LoadMoreCommand}"
                    IsVisible="{Binding CanLoadMore.Value}"
                    HorizontalOptions="Fill"
                    Padding="24,12"
                    FontSize="13" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>


