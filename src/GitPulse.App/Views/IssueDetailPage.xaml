<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GitPulse.ViewModels;assembly=GitPulse.ViewModels"
             xmlns:models="clr-namespace:GitPulse.Core.Models;assembly=GitPulse.Core"
             xmlns:idk="clr-namespace:Indiko.Maui.Controls.Markdown;assembly=Indiko.Maui.Controls.Markdown"
             x:Class="GitPulse.App.Views.IssueDetailPage"
             x:DataType="vm:IssueDetailViewModel"
             Title="Issue Detail">

    <Grid RowDefinitions="Auto,*">

        <!-- Back + title: Grid so long titles truncate instead of clipping Back. -->
        <VerticalStackLayout Grid.Row="0" Spacing="4" Padding="16,8,16,4">
            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                <Button Text="Back"
                        Clicked="OnBackClicked"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Primary}"
                        Padding="8,10"
                        VerticalOptions="Center" />
                <Label Grid.Column="1"
                       Text="Issues"
                       FontSize="14"
                       TextColor="{StaticResource Gray500}"
                       VerticalOptions="Center" />
                <Label Grid.Column="2"
                       Text="{Binding Issue.Value.Number, StringFormat='#{0}'}"
                       FontSize="14"
                       TextColor="{StaticResource Gray500}"
                       LineBreakMode="TailTruncation"
                       MaxLines="1"
                       VerticalOptions="Center" />
            </Grid>
            <Label Text="{Binding Title.Value}"
                   FontSize="20"
                   FontAttributes="Bold"
                   LineBreakMode="WordWrap" />
            <Border IsVisible="{Binding ErrorMessage.Value, Converter={StaticResource StringToBoolConverter}}"
                    BackgroundColor="{StaticResource Red100}"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 8"
                    Padding="12"
                    Margin="0,8,0,0">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <Label Text="{Binding ErrorMessage.Value}"
                           TextColor="{StaticResource Red900}"
                           FontSize="13"
                           LineBreakMode="WordWrap"
                           VerticalOptions="Center" />
                    <Button Grid.Column="1"
                            Text="Retry"
                            Command="{Binding LoadCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource Red900}"
                            Padding="8,10"
                            FontSize="13" />
                    <Button Grid.Column="2"
                            Text="Back"
                            Clicked="OnBackClicked"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource Red900}"
                            Padding="8,10"
                            FontSize="13" />
                </Grid>
            </Border>
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <Grid x:Name="IssueBody"
                  ColumnDefinitions="*"
                  RowDefinitions="Auto,Auto"
                  ColumnSpacing="24"
                  Padding="16">
                <VerticalStackLayout x:Name="IssueMain" Spacing="12">

                <!-- Issue header -->
                <VerticalStackLayout Spacing="8">
                        <VerticalStackLayout Spacing="2">
                            <HorizontalStackLayout Spacing="6">
                                <Image Source="{Binding Issue.Value, Converter={StaticResource IssueIconConverter}}"
                                       WidthRequest="16"
                                       HeightRequest="16"
                                       VerticalOptions="Center" />
                                <Label Text="{Binding Issue.Value, Converter={StaticResource IssueStateTextConverter}}"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="{Binding Issue.Value, Converter={StaticResource IssueStateColorConverter}}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Label Text="{Binding Issue.Value.User.Login, StringFormat='by {0}'}"
                                   FontSize="12"
                                   TextColor="{StaticResource Gray500}"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="1" />
                            <Label Text="{Binding Issue.Value.CreatedAt, StringFormat='{0:yyyy-MM-dd}'}"
                                   FontSize="12"
                                   TextColor="{StaticResource Gray500}" />
                        </VerticalStackLayout>

                        <idk:MarkdownView MarkdownText="{Binding Issue.Value.Body}"
                                          UseAppTheme="True"
                                          H1FontSize="20"
                                          H2FontSize="18"
                                          H3FontSize="16"
                                          TextFontSize="14" />

                        <Label Text="{Binding Issue.Value.CommentsCount, StringFormat='Comments: {0}'}"
                               FontSize="12"
                               TextColor="{StaticResource Gray500}"
                               Margin="0,4,0,0" />

                        <!-- Full-width state actions stay tappable on narrow portrait widths. -->
                        <VerticalStackLayout Spacing="8">
                            <Button Text="Close issue"
                                    Command="{Binding ToggleStateCommand}"
                                    IsVisible="{Binding Issue.Value.State, Converter={StaticResource StringEqualsConverter}, ConverterParameter=open}"
                                    BackgroundColor="{StaticResource Purple700}"
                                    TextColor="White"
                                    Padding="16,12"
                                    FontSize="13"
                                    HorizontalOptions="Fill" />
                            <Button Text="Reopen"
                                    Command="{Binding ToggleStateCommand}"
                                    IsVisible="{Binding Issue.Value.State, Converter={StaticResource StringEqualsConverter}, ConverterParameter=closed}"
                                    BackgroundColor="{StaticResource Green700}"
                                    TextColor="White"
                                    Padding="16,12"
                                    FontSize="13"
                                    HorizontalOptions="Fill" />
                        </VerticalStackLayout>

                </VerticalStackLayout>
                <!-- Comments section header -->
                <Label Text="Comments"
                       FontSize="16"
                       FontAttributes="Bold"
                       Margin="0,8,0,4" />

                <!-- Comments list via BindableLayout -->
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Comments}"
                                     Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:Comment">
                            <VerticalStackLayout Spacing="0">
                                <VerticalStackLayout Spacing="6" Padding="0,12">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Label Grid.Column="0"
                                               Text="{Binding User.Login}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="1"
                                               VerticalOptions="Center" />
                                        <Label Grid.Column="1"
                                               Text="{Binding CreatedAt, StringFormat='{0:yyyy-MM-dd HH:mm}'}"
                                               FontSize="12"
                                               TextColor="{StaticResource Gray500}"
                                               VerticalOptions="Center" />
                                    </Grid>
                                    <idk:MarkdownView MarkdownText="{Binding Body}"
                                                      UseAppTheme="True"
                                                      H1FontSize="16"
                                                      H2FontSize="15"
                                                      H3FontSize="14"
                                                      TextFontSize="13" />
                                </VerticalStackLayout>
                                <BoxView Style="{StaticResource Hairline}" Margin="0" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <VerticalStackLayout
                        IsVisible="{Binding Comments.Count, Converter={StaticResource IntGreaterThanZeroConverter}, ConverterParameter=invert}"
                        Spacing="4"
                        Padding="0,8">
                    <Label Text="No comments"
                           FontSize="16"
                           TextColor="{StaticResource Gray500}"
                           HorizontalOptions="Center" />
                    <Label Text="Start the conversation below."
                           FontSize="14"
                           TextColor="{StaticResource Gray400}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Comment input: full-width Comment stays reachable after AdjustResize + scroll. -->
                <VerticalStackLayout Spacing="8" Margin="0,8,0,0">
                    <Label Text="Add a comment"
                           FontSize="14"
                           FontAttributes="Bold" />
                    <Editor Text="{Binding CommentInput.Value}"
                            Placeholder="Write a comment... (Markdown supported)"
                            AutoSize="TextChanges"
                            FontSize="14"
                            MinimumHeightRequest="80"
                            HorizontalOptions="Fill" />
                    <Button Text="Comment"
                            Command="{Binding AddCommentCommand}"
                            IsEnabled="{Binding IsSaving.Value, Converter={StaticResource InvertedBoolConverter}}"
                            HorizontalOptions="Fill"
                            Padding="24,12"
                            FontSize="14" />
                    <ActivityIndicator IsRunning="{Binding IsSaving.Value}"
                                       IsVisible="{Binding IsSaving.Value}" />
                </VerticalStackLayout>

                <ActivityIndicator IsRunning="{Binding IsLoading.Value}"
                                   IsVisible="{Binding IsLoading.Value}" />


                </VerticalStackLayout>
                <VerticalStackLayout x:Name="IssueRail"
                                     Grid.Row="1"
                                     Spacing="12"
                                     VerticalOptions="Start">
                        <!-- Labels editor: stack so Entry and Save remain usable with IME. -->
                        <VerticalStackLayout Spacing="4" Margin="0,4,0,0">
                            <Label Text="Labels"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Gray500}" />
                            <Entry Text="{Binding LabelInput.Value}"
                                   Placeholder="bug, enhancement, ..."
                                   FontSize="13"
                                   HorizontalOptions="Fill" />
                            <Button Text="Save labels"
                                    Command="{Binding SaveLabelsCommand}"
                                    Padding="16,12"
                                    FontSize="13"
                                    HorizontalOptions="Fill" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6" Margin="0,8,0,0">
                            <Label Text="Assignees"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Gray500}" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Assignees}"
                                                 Spacing="6">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:User">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <Label Grid.Column="0"
                                                   Text="{Binding Login}"
                                                   FontSize="13"
                                                   VerticalOptions="Center"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="1" />
                                            <Button Grid.Column="1"
                                                    Text="Remove"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:IssueDetailViewModel}}, Path=RemoveAssigneeCommand}"
                                                    CommandParameter="{Binding Login}"
                                                    Padding="12,8"
                                                    FontSize="12" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Entry Grid.Column="0"
                                       Placeholder="GitHub login"
                                       Text="{Binding AssigneeLogin.Value}"
                                       FontSize="13"
                                       AutomationId="IssueAssigneeLogin" />
                                <Button Grid.Column="1"
                                        Text="Assign"
                                        Command="{Binding AddAssigneeCommand}"
                                        Padding="16,10"
                                        FontSize="13" />
                            </Grid>
                        </VerticalStackLayout>
                </VerticalStackLayout>
            </Grid>
        </ScrollView>

    </Grid>

</ContentPage>
