<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GitPulse.ViewModels;assembly=GitPulse.ViewModels"
             xmlns:models="clr-namespace:GitPulse.Core.Models;assembly=GitPulse.Core"
             x:Class="GitPulse.App.Views.WorkflowRunDetailPage"
             x:DataType="vm:WorkflowRunDetailViewModel"
             Title="Workflow Run">

    <Grid RowDefinitions="Auto,*">

        <!-- Back + title: Grid so long titles truncate instead of clipping Back. -->
        <VerticalStackLayout Grid.Row="0" Spacing="4" Padding="16,8,16,4">
            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                <Button Text="Back"
                        Clicked="OnBackClicked"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Primary}"
                        Padding="8,10"
                        VerticalOptions="Center" />
                <Label Grid.Column="1"
                       Text="Actions"
                       FontSize="14"
                       TextColor="{StaticResource Gray500}"
                       VerticalOptions="Center" />
                <Label Grid.Column="2"
                       Text="{Binding Run.Value.Id, StringFormat='#{0}'}"
                       FontSize="14"
                       TextColor="{StaticResource Gray500}"
                       VerticalOptions="Center"
                       LineBreakMode="TailTruncation"
                       MaxLines="1" />
            </Grid>
            <Label Text="{Binding Title.Value}"
                   FontSize="20"
                   FontAttributes="Bold"
                   LineBreakMode="WordWrap" />
            <Border IsVisible="{Binding ErrorMessage.Value, Converter={StaticResource StringToBoolConverter}}"
                    BackgroundColor="{StaticResource Red100}"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 8"
                    Padding="12"
                    Margin="0,8,0,0">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <Label Text="{Binding ErrorMessage.Value}"
                           TextColor="{StaticResource Red900}"
                           FontSize="13"
                           LineBreakMode="WordWrap"
                           VerticalOptions="Center" />
                    <Button Grid.Column="1"
                            Text="Retry"
                            Command="{Binding LoadCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource Red900}"
                            Padding="8,10"
                            FontSize="13" />
                    <Button Grid.Column="2"
                            Text="Back"
                            Clicked="OnBackClicked"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource Red900}"
                            Padding="8,10"
                            FontSize="13" />
                </Grid>
            </Border>
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="12">


                <ActivityIndicator IsRunning="{Binding IsLoading.Value}"
                                   IsVisible="{Binding IsLoading.Value}"
                                   HorizontalOptions="Center" />

                <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding StatusSummary.Value}"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{Binding Run.Value.Conclusion, Converter={StaticResource CheckConclusionColorConverter}}"
                               LineBreakMode="WordWrap" />
                        <Label Text="{Binding Run.Value.Name, StringFormat='Workflow: {0}'}"
                               FontSize="12"
                               TextColor="{StaticResource Gray500}"
                               LineBreakMode="TailTruncation"
                               MaxLines="2" />
                        <Label Text="{Binding Run.Value.HeadBranch, StringFormat='Branch: {0}'}"
                               FontSize="12"
                               TextColor="{StaticResource Gray500}"
                               LineBreakMode="TailTruncation"
                               MaxLines="1" />
                        <Label Text="{Binding Run.Value.Event, StringFormat='Event: {0}'}"
                               FontSize="12"
                               TextColor="{StaticResource Gray500}"
                               LineBreakMode="TailTruncation"
                               MaxLines="1" />
                        <Label Text="{Binding Run.Value.CreatedAt, StringFormat='Created {0:yyyy-MM-dd HH:mm}'}"
                               FontSize="12"
                               TextColor="{StaticResource Gray500}" />

                        <!-- Full-width actions stay tappable on narrow portrait widths.
                             Rerun is spot-check only (cramped OK). -->
                        <VerticalStackLayout Spacing="8" Margin="0,8,0,0">
                            <Button Text="Re-run"
                                    Command="{Binding RerunCommand}"
                                    IsEnabled="{Binding IsRerunning.Value, Converter={StaticResource InvertedBoolConverter}}"
                                    BackgroundColor="{StaticResource Primary}"
                                    TextColor="White"
                                    Padding="16,12"
                                    FontSize="13"
                                    HorizontalOptions="Fill" />
                            <Button Text="↗ Browser"
                                    Command="{Binding OpenInBrowserCommand}"
                                    CommandParameter="{Binding Run.Value.HtmlUrl}"
                                    BackgroundColor="Transparent"
                                    TextColor="{StaticResource Primary}"
                                    Padding="16,12"
                                    FontSize="13"
                                    HorizontalOptions="Fill" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                <Label Text="Jobs"
                       FontSize="16"
                       FontAttributes="Bold"
                       Margin="0,8,0,0" />

                <!-- BindableLayout avoids nested CollectionView-in-ScrollView sizing issues on phone. -->
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Jobs}"
                                     Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:WorkflowJob">
                            <VerticalStackLayout Spacing="0">
                            <Grid ColumnDefinitions="Auto,*"
                                  Padding="0,12"
                                  MinimumHeightRequest="{OnPlatform Android=56, Default=48}"
                                  ColumnSpacing="10">
                                <Image Source="check_circle_16.png"
                                       WidthRequest="16"
                                       HeightRequest="16"
                                       VerticalOptions="Start"
                                       Margin="0,2,0,0" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="{Binding Name}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="1" />
                                    <Label Text="{Binding Conclusion}"
                                           FontSize="12"
                                           TextColor="{Binding Conclusion, Converter={StaticResource CheckConclusionColorConverter}}" />
                                </VerticalStackLayout>
                            </Grid>
                            <BoxView Style="{StaticResource Hairline}" Margin="0" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <VerticalStackLayout
                        IsVisible="{Binding Jobs.Count, Converter={StaticResource IntGreaterThanZeroConverter}, ConverterParameter=invert}"
                        Spacing="4"
                        Padding="0,8">
                    <Label Text="No jobs"
                           FontSize="16"
                           TextColor="{StaticResource Gray500}"
                           HorizontalOptions="Center" />
                    <Label Text="This run has not reported jobs yet."
                           FontSize="14"
                           TextColor="{StaticResource Gray400}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
