<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NukeTelemetryVersion>1</NukeTelemetryVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace></RootNamespace>
    <!-- The Nuke build project manages its own package versions independently
         of the repo-wide central package management. -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nuke.Common">
      <Version>10.1.0</Version>
    </PackageReference>
    <!-- Nuke.Common 10.1.0 (latest) still pulls Xml 9.0.0; pin the patched 10.0 line. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.12" />
    <PackageReference Include="NuGet.Packaging" Version="6.14.3" />
  </ItemGroup>

</Project>
