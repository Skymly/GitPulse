<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>GitPulse.Tests</RootNamespace>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="coverlet.collector">
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		  <PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
		<PackageReference Include="xunit.v3" />
		<PackageReference Include="xunit.runner.visualstudio" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\GitPulse.Core\GitPulse.Core.csproj" />
		<ProjectReference Include="..\..\src\GitPulse.GitHubApi\GitPulse.GitHubApi.csproj" />
		<ProjectReference Include="..\..\src\GitPulse.Services\GitPulse.Services.csproj" />
		<ProjectReference Include="..\..\src\GitPulse.ViewModels\GitPulse.ViewModels.csproj" />
	</ItemGroup>

	<!-- App sources that are net10.0 with no MAUI usings compile here so CiLib
	     covers them without referencing GitPulse.App: the UI-test PAT store and
	     the page ViewModel lifetime decision table. -->
	<ItemGroup>
		<Compile Include="..\..\src\GitPulse.App\UiTestHost.cs" Link="App\UiTestHost.cs" />
		<Compile Include="..\..\src\GitPulse.App\Services\InMemoryCredentialStore.cs" Link="App\InMemoryCredentialStore.cs" />
		<Compile Include="..\..\src\GitPulse.App\Services\UiTestHostCredentialStore.cs" Link="App\UiTestHostCredentialStore.cs" />
		<Compile Include="..\..\src\GitPulse.App\Views\PageViewModelLifetime.cs" Link="App\PageViewModelLifetime.cs" />
	</ItemGroup>

</Project>
